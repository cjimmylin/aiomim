\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces OMIM facts conveyed for the same papers with their full text hidden (46 entries, 136 paragraphs). Full-text arm: the direct-reading draft before the repair round, so no arm was repaired. Bars: fact counts pooled over the same 2,120 fixed facts in each condition (contradicted facts, 4, 10 and 10, are too few to see). Printed: coverage as the mean over the 46 entries, and the paired difference from the abstract-only draft with its bootstrap 95\% interval over entries.}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:hidden}{{2}{7}{OMIM facts conveyed for the same papers with their full text hidden (46 entries, 136 paragraphs). Full-text arm: the direct-reading draft before the repair round, so no arm was repaired. Bars: fact counts pooled over the same 2,120 fixed facts in each condition (contradicted facts, 4, 10 and 10, are too few to see). Printed: coverage as the mean over the 46 entries, and the paired difference from the abstract-only draft with its bootstrap 95\% interval over entries}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Where the facts direct reading did not fully convey went (97 entries, 466 paragraphs; pooled over facts). Each missed fact was checked once against the text available for its paper, a model judgement; partly conveyed facts count as missed. Above each bar: facts and the share of missed facts stated in the available text.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:missed}{{3}{7}{Where the facts direct reading did not fully convey went (97 entries, 466 paragraphs; pooled over facts). Each missed fact was checked once against the text available for its paper, a model judgement; partly conveyed facts count as missed. Above each bar: facts and the share of missed facts stated in the available text}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Main comparison on the 93 entries every strategy completed (means over entries). Facts: OMIM facts conveyed (primary endpoint). $\Delta $: paired difference from direct reading in points, bootstrap 95\% interval, and entries better/worse/tied. Secondary: claims judged supported (after repair, except for the memory-only control, which is audited but not repaired), synopsis HPO F1 (exact), OMIM variants recovered, variant precision, causal-gene F1 and inheritance match (\%). Subscripts give $n$ where fewer than 93 entries contribute; variant precision rests on only 23 entries for recall, then verify and 30 for the memory-only control.}}{7}{table.1}\protected@file@percent }
\newlabel{tab:main}{{1}{7}{Main comparison on the 93 entries every strategy completed (means over entries). Facts: OMIM facts conveyed (primary endpoint). $\Delta $: paired difference from direct reading in points, bootstrap 95\% interval, and entries better/worse/tied. Secondary: claims judged supported (after repair, except for the memory-only control, which is audited but not repaired), synopsis HPO F1 (exact), OMIM variants recovered, variant precision, causal-gene F1 and inheritance match (\%). Subscripts give $n$ where fewer than 93 entries contribute; variant precision rests on only 23 entries for recall, then verify and 30 for the memory-only control}{table.1}{}}
