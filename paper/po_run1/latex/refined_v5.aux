\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Paired difference from direct reading in OMIM facts conveyed (points, means over entries, 95\% intervals) by the share of an entry's references readable in full; the one entry with all references in full text is in no group. Shaded: replicate-noise half-widths for a difference over 93 entries ($\pm $1.0) and over 30 entries ($\pm $1.8), a yardstick, not a test; the groups have 21--46 entries, so the $\pm $1.8 band is the nearer guide. Memory-based strategies are off scale ($-18.1$ to $-59.6$; Appendix Table~\ref {tab:app_strata}). Observational.}}{10}{figure.4}\protected@file@percent }
\newlabel{fig:strata}{{4}{10}{Paired difference from direct reading in OMIM facts conveyed (points, means over entries, 95\% intervals) by the share of an entry's references readable in full; the one entry with all references in full text is in no group. Shaded: replicate-noise half-widths for a difference over 93 entries ($\pm $1.0) and over 30 entries ($\pm $1.8), a yardstick, not a test; the groups have 21--46 entries, so the $\pm $1.8 band is the nearer guide. Memory-based strategies are off scale ($-18.1$ to $-59.6$; Appendix Table~\ref {tab:app_strata}). Observational}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces OMIM facts conveyed (top) and causal-gene F1 (bottom), memory-only control and direct reading, means over entries by creation era (entries per band 18, 19, 20, 19, 17). Hollow markers: 20 entries created June to November 2026. A contamination check, not proof that reading is free of memorisation.}}{10}{figure.5}\protected@file@percent }
\newlabel{fig:memory}{{5}{10}{OMIM facts conveyed (top) and causal-gene F1 (bottom), memory-only control and direct reading, means over entries by creation era (entries per band 18, 19, 20, 19, 17). Hollow markers: 20 entries created June to November 2026. A contamination check, not proof that reading is free of memorisation}{figure.5}{}}
