# aiomim reads its settings from the environment. Every value here is optional.

# --- Model --------------------------------------------------------------------
# The pipeline calls Claude through the Claude Code CLI (`claude -p`), so it runs
# on your Claude subscription. Log in once with `claude` -> /login.
# AIOMIM_CLAUDE_BIN=claude
# AIOMIM_MODEL=claude-opus-5-5          # model for every stage
# AIOMIM_MODEL_EXTRACT=claude-opus-5-5  # ...or per stage: PLAN, TRIAGE, EXTRACT,
#                                       # NORMALIZE, SYNTHESIZE, VERIFY, JUDGE, UPDATE
# AIOMIM_EFFORT_SYNTHESIZE=high         # low | medium | high | xhigh | max, per stage
# AIOMIM_LLM_CONCURRENCY=4              # parallel model calls within one entry
# AIOMIM_LLM_TIMEOUT=900                # seconds per call

# --- Data ---------------------------------------------------------------------
# AIOMIM_HOME=data                      # caches: HTTP, model replies, ontologies, gold
# AIOMIM_RUNS=runs                      # run outputs
# NCBI_API_KEY=                         # raises the E-utilities limit from 3 to 10 requests/s
# NCBI_EMAIL=                           # sent to NCBI only if you set it
# OMIM_API_KEY=                         # enables scoring against full OMIM text (https://omim.org/api)
