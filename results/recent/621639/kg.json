1265451","type":"Paper","label":"Bresack et al. (2025)","pmid":"41265451","year":2025,"content_level":"abstract","relevance":"primary","title":"Genetic variants in ESRRG are associated with a dominant non-progressive congenital movement disorder with ataxia."},{"id":"paper:35982091","type":"Paper","label":"Fox et al. (2022)","pmid":"35982091","year":2022,"content_level":"fulltext","relevance":"not_relevant","title":"Estrogen-related receptor gamma regulates mitochondrial and synaptic genes and modulates vulnerability to synucleinopathy."},{"id":"finding:41265451:1","type":"Finding","label":"Bresack et al. (2025) described 8 individuals from 7 unrelated families with a non-progressive congenital movement disorder with ataxia. All had motor developmental delay, muscular hypotonia, eye movement disorders, and congenital ataxia or gait imbalance. Other features included joint hyperflexibility, dysarthria, myopia, and growth delay.","pmid":"41265451","section":"clinical_features"},{"id":"gene:ESRRG","type":"Gene","label":"ESRRG"},{"id":"hpo:HP:0001270","type":"Phenotype","label":"Motor delay","hpo_id":"HP:0001270"},{"id":"hpo:HP:0001252","type":"Phenotype","label":"Hypotonia","hpo_id":"HP:0001252"},{"id":"hpo:HP:0000496","type":"Phenotype","label":"Abnormality of eye movement","hpo_id":"HP:0000496"},{"id":"hpo:HP:0001251","type":"Phenotype","label":"Ataxia","hpo_id":"HP:0001251"},{"id":"hpo:HP:0001382","type":"Phenotype","label":"Joint hypermobility","hpo_id":"HP:0001382"},{"id":"hpo:HP:0001260","type":"Phenotype","label":"Dysarthria","hpo_id":"HP:0001260"},{"id":"hpo:HP:0000545","type":"Phenotype","label":"Myopia","hpo_id":"HP:0000545"},{"id":"hpo:HP:0001510","type":"Phenotype","label":"Growth delay","hpo_id":"HP:0001510"},{"id":"inh:AD","type":"Inheritance","label":"Autosomal dominant","hpo_id":"HP:0000006"},{"id":"finding:41265451:2","type":"Finding","label":"Bresack et al. (2025) found heterozygous ESRRG variants, most of them de novo, in the affected individuals. This is consistent with autosomal dominant inheritance.","pmid":"41265451","section":"inheritance"},{"id":"finding:41265451:3","type":"Finding","label":"Bresack et al. (2025) identified a heterozygous c.410G>A (p.Gly137Glu) variant in ESRRG in a patient with a non-progressive congenital movement disorder with ataxia. The variant was absent from gnomAD v4.1, predicted deleterious in silico, and located in an intolerant segment of the protein. It showed reduced transcriptional activity in an ERRE reporter assay and failed to restore proliferation in ESRRG-knockout HEK293T cells.","pmid":"41265451","section":"molecular_genetics"},{"id":"variant:ESRRG:c.410G>A","type":"Variant","label":"ESRRG c.410G>A / p.G137E","gene":"ESRRG","keys":["c.410G>A","p.G137E"],"omim_name":"ESRRG, GLY137GLU"},{"id":"finding:41265451:4","type":"Finding","label":"Bresack et al. (2025) identified a heterozygous c.446A>G (p.Lys149Arg) variant in ESRRG in a patient with a non-progressive congenital movement disorder with ataxia. The variant was absent from gnomAD v4.1, predicted deleterious in silico, and located in an intolerant segment of the protein. It showed reduced transcriptional activity in an ERRE reporter assay.","pmid":"41265451","section":"molecular_genetics"},{"id":"variant:ESRRG:c.446A>G","type":"Variant","label":"ESRRG c.446A>G / p.K149R","gene":"ESRRG","keys":["c.446A>G","p.K149R"],"omim_name":"ESRRG, LYS149ARG"},{"id":"finding:41265451:5","type":"Finding","label":"Bresack et al. (2025) identified a heterozygous c.539G>A (p.Cys180Tyr) variant in ESRRG in a patient with a non-progressive congenital movement disorder with ataxia. The variant was absent from gnomAD v4.1, predicted deleterious in silico, and located in an intolerant segment of the protein. It showed reduced transcriptional activity in an ERRE reporter assay.","pmid":"41265451","section":"molecular_genetics"},{"id":"variant:ESRRG:c.539G>A","type":"Variant","label":"ESRRG c.539G>A / p.C180Y","gene":"ESRRG","keys":["c.539G>A","p.C180Y"],"omim_name":"ESRRG, CYS180TYR"},{"id":"finding:41265451:6","type":"Finding","label":"Bresack et al. (2025) identified a heterozygous c.550C>T (p.Arg184Cys) variant in ESRRG in a patient with a non-progressive congenital movement disorder with ataxia. The variant was absent from gnomAD v4.1, predicted deleterious in silico, and located in an intolerant segment of the protein. It showed reduced transcriptional activity in an ERRE reporter assay.","pmid":"41265451","section":"molecular_genetics"},{"id":"variant:ESRRG:c.550C>T","type":"Variant","label":"ESRRG c.550C>T / p.R184C","gene":"ESRRG","keys":["c.550C>T","p.R184C"],"omim_name":"ESRRG, ARG184CYS"},{"id":"finding:41265451:7","type":"Finding","label":"Bresack et al. (2025) identified a heterozygous c.1346T>G (p.Leu449Arg) variant in ESRRG in a patient with a non-progressive congenital movement disorder with ataxia. The variant was absent from gnomAD v4.1, predicted deleterious in silico, and located in an intolerant segment of the protein. It showed reduced transcriptional activity in an ERRE reporter assay.","pmid":"41265451","section":"molecular_genetics"},{"id":"variant:ESRRG:c.1346T>G","type":"Variant","label":"ESRRG c.1346T>G / p.L449R","gene":"ESRRG","keys":["c.1346T>G","p.L449R"],"omim_name":"ESRRG, LEU449ARG"},{"id":"finding:41265451:8","type":"Finding","label":"Bresack et al. (2025) identified a heterozygous 1-bp duplication, c.1352dup (p.Leu451Phefs*38), in ESRRG in a patient with a non-progressive congenital movement disorder with ataxia. The variant was absent from gnomAD v4.1, predicted deleterious in silico, and located in an intolerant segment of the protein. It showed reduced transcriptional activity in an ERRE reporter assay.","pmid":"41265451","section":"molecular_genetics"},{"id":"variant:ESRRG:c.1352dup","type":"Variant","label":"ESRRG c.1352dup / p.L451Ffs / p.L451fs","gene":"ESRRG","keys":["c.1352dup","p.L451Ffs","p.L451fs"],"omim_name":"ESRRG, LEU451PHEFS"},{"id":"finding:41265451:9","type":"Finding","label":"Bresack et al. (2025) found that ESRRG knockout significantly increased the proliferation rate of HEK293T cells. Wild-type ESRRG restored normal proliferation, but none of the patient variants did. All variants localized correctly to the nucleus but significantly reduced transcriptional activity in an ERRE reporter assay. Molecular modeling also suggested reduced protein function.","pmid":"41265451","section":"pathogenesis"}],"edges":[{"src":"paper:41265451","rel":"reports","dst":"finding:41265451:1"},{"src":"finding:41265451:1","rel":"in_section","dst":"section:clinical_features"},{"src":"finding:41265451:1","rel":"mentions_gene","dst":"gene:ESRRG","pmid":"41265451"},{"src":"finding:41265451:1","rel":"has_phenotype","dst":"hpo:HP:0001270","pmid":"41265451","present":true,"frequency":"8/8","text":"motor developmental delay"},{"src":"finding:41265451:1","rel":"has_phenotype","dst":"hpo:HP:0001252","pmid":"41265451","present":true,"frequency":"8/8","text":"muscular hypotonia"},{"src":"finding:41265451:1","rel":"has_phenotype","dst":"hpo:HP:0000496","pmid":"41265451","present":true,"frequency":"8/8","text":"eye movement disorders"},{"src":"finding:41265451:1","rel":"has_phenotype","dst":"hpo:HP:0001251","pmid":"41265451","present":true,"frequency":"8/8","text":"congenital ataxia or gait imbalance"},{"src":"finding:41265451:1","rel":"has_phenotype","dst":"hpo:HP:0001382","pmid":"41265451","present":true,"text":"joint hyperflexibility"},{"src":"finding:41265451:1","rel":"has_phenotype","dst":"hpo:HP:0001260","pmid":"41265451","present":true,"text":"dysarthria"},{"src":"finding:41265451:1","rel":"has_phenotype","dst":"hpo:HP:0000545","pmid":"41265451","present":true,"text":"myopia"},{"src":"finding:41265451:1","rel":"has_phenotype","dst":"hpo:HP:0001510","pmid":"41265451","present":true,"text":"growth delay"},{"src":"finding:41265451:1","rel":"asserts_inheritance","dst":"inh:AD","pmid":"41265451"},{"src":"paper:41265451","rel":"reports","d