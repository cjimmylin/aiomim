{"seed":{"mim":"621777","entry_type":"phenotype","prefix":"#","title":"DEVELOPMENTAL AND EPILEPTIC ENCEPHALOPATHY 123","alt_titles":[],"symbol":"DEE123","gene_symbols":[],"seed_pmids":[],"max_year":2025},"nodes":[{"id":"entry","type":"Entry","label":"DEVELOPMENTAL AND EPILEPTIC ENCEPHALOPATHY 123","mim":"621777","entry_type":"phenotype"},{"id":"section:description","type":"Section","label":"description"},{"id":"section:nomenclature","type":"Section","label":"nomenclature"},{"id":"section:cloning_expression","type":"Section","label":"cloning_expression"},{"id":"section:gene_structure","type":"Section","label":"gene_structure"},{"id":"section:clinical_features","type":"Section","label":"clinical_features"},{"id":"section:other_features","type":"Section","label":"other_features"},{"id":"section:biochemical_features","type":"Section","label":"biochemical_features"},{"id":"section:inheritance","type":"Section","label":"inheritance"},{"id":"section:cytogenetics","type":"Section","label":"cytogenetics"},{"id":"section:mapping","type":"Section","label":"mapping"},{"id":"section:heterogeneity","type":"Section","label":"heterogeneity"},{"id":"section:gene_function","type":"Section","label":"gene_function"},{"id":"section:molecular_genetics","type":"Section","label":"molecular_genetics"},{"id":"section:genotype_phenotype_correlations","type":"Section","label":"genotype_phenotype_correlations"},{"id":"section:pathogenesis","type":"Section","label":"pathogenesis"},{"id":"section:diagnosis","type":"Section","label":"diagnosis"},{"id":"section:clinical_management","type":"Section","label":"clinical_management"},{"id":"section:population_genetics","type":"Section","label":"population_genetics"},{"id":"section:evolution","type":"Section","label":"evolution"},{"id":"section:animal_model","type":"Section","label":"animal_model"},{"id":"section:history","type":"Section","label":"history"},{"id":"paper:40812465","type":"Paper","label":"Dehghanzad et al. (2025)","pmid":"40812465","year":2025,"content_level":"abstract","relevance":"primary","title":"Autosomal recessive frameshift variant broadens HECW2-related disease spectrum."},{"id":"paper:35753050","type":"Paper","label":"Rodríguez-García et al. (2022)","pmid":"35753050","year":2022,"content_level":"abstract","relevance":"primary","title":"First splicing variant in HECW2 with an autosomal recessive pattern of inheritance and associated with NDHSAL."},{"id":"paper:35487419","type":"Paper","label":"Krami et al. (2022)","pmid":"35487419","year":2022,"content_level":"abstract","relevance":"primary","title":"A homozygous nonsense HECW2 variant is associated with neurodevelopmental delay and intellectual disability."},{"id":"finding:35487419:1","type":"Finding","label":"Krami et al. (2022) reported a proband from a consanguineous Moroccan family who had developmental delay, intellectual disability, hypotonia, generalized tonic-clonic seizures, and a persistent tilted head.","pmid":"35487419","section":"clinical_features"},{"id":"gene:HECW2","type":"Gene","label":"HECW2"},{"id":"hpo:HP:0001263","type":"Phenotype","label":"Global developmental delay","hpo_id":"HP:0001263"},{"id":"hpo:HP:0001249","type":"Phenotype","label":"Intellectual disability","hpo_id":"HP:0001249"},{"id":"hpo:HP:0001252","type":"Phenotype","label":"Hypotonia","hpo_id":"HP:0001252"},{"id":"hpo:HP:0025190","type":"Phenotype","label":"Bilateral tonic-clonic seizure with generalized onset","hpo_id":"HP:0025190"},{"id":"hpo:HP:0000473","type":"Phenotype","label":"Torticollis","hpo_id":"HP:0000473"},{"id":"inh:AR","type":"Inheritance","label":"Autosomal recessive","hpo_id":"HP:0000007"},{"id":"finding:35487419:2","type":"Finding","label":"In a proband from a consanguineous Moroccan family with developmental delay, intellectual disability, hypotonia, and seizures, Krami et al. (2022) used whole-exome sequencing to identify a homozygous nonsense variant in the HECW2 gene (c.736C>T, p.Arg246Ter). The authors noted that this was the first homozygous HECW2 variant, in contrast to the de novo heterozygous variants reported earlier.","pmid":"35487419","section":"molecular_genetics"},{"id":"variant:HECW2:c.736C>T","type":"Variant","label":"HECW2 c.736C>T / p.R246*","gene":"HECW2","keys":["c.736C>T","p.R246*"],"omim_name":"HECW2, ARG246TER"},{"id":"finding:35487419:3","type":"Finding","label":"Krami et al. (2022) concluded that the homozygous HECW2 variant in their consanguineous Moroccan family was inherited in an autosomal recessive pattern.","pmid":"35487419","section":"inheritance"},{"id":"finding:35753050:1","type":"Finding","label":"Rodríguez-García et al. (2022) reported a Caucasian girl with a severe neurodevelopmental disorder, drug-resistant epilepsy, hypotonia, severe gastroesophageal reflux, and brain MRI anomalies.","pmid":"35753050","section":"clinical_features"},{"id":"hpo:HP:0012759","type":"Phenotype","label":"Neurodevelopmental abnormality","hpo_id":"HP:0012759"},{"id":"hpo:HP:0001250","type":"Phenotype","label":"Seizure","hpo_id":"HP:0001250"},{"id":"hpo:HP:0002020","type":"Phenotype","label":"Gastroesophageal reflux","hpo_id":"HP:0002020"},{"id":"hpo:HP:0012443","type":"Phenotype","label":"Abnormal brain morphology","hpo_id":"HP:0012443"},{"id":"finding:35753050:2","type":"Finding","label":"In a Caucasian girl with a severe neurodevelopmental disorder and drug-resistant epilepsy, Rodríguez-García et al. (2022) found a novel homozygous variant in the HECW2 gene (g.197092814_197092824delinsC) by whole-exome sequencing. The variant disrupted the splice donor site of intron 22 and caused skipping of exon 22 (r.3766_3917+1del), which led to an in-frame deletion (p.Leu1256_Trp1306del). Functional studies showed a twofold increase in RNA expression but a 60% reduction in protein level. The authors suggested a partial loss-of-function mechanism and called this the first patient with NDHSAL caused by an autosomal recessive splicing variant in HECW2.","pmid":"35753050","section":"molecular_genetics"},{"id":"variant:HECW2:g.197092814_197092824delinsc","type":"Variant","label":"HECW2 g.197092814_197092824delinsc / p.L1256_W1306del","gene":"HECW2","keys":["g.197092814_197092824delinsc","p.L1256_W1306del"],"omim_name":"HECW2, LEU1256_TRP1306DEL"},{"id":"finding:35753050:3","type":"Finding","label":"Rodríguez-García et al. (2022) noted that de novo heterozygous missense variants in HECW2 had previously been associated with neurodevelopmental disorder with hypotonia, seizures, and absent language (NDHSAL). In contrast, their patient had an autosomal recessive splicing variant.","pmid":"35753050","section":"heterogeneity"},{"id":"finding:40812465:1","type":"Finding","label":"Dehghanzad et al. (2025) reported a 6-year-old girl, born to consanguineous parents of Afghan descent, who had severe microcephaly, hypotonia, failure to thrive, recurrent seizures, and global neurodevelopmental delay. Brain MRI showed significant cerebral and cerebellar atrophy.","pmid":"40812465","section":"clinical_features"},{"id":"hpo:HP:0000252","type":"Phenotype","label":"Microcephaly","hpo_id":"HP:0000252"},{"id":"hpo:HP:0001508","type":"Phenotype","label":"Failure to thrive","hpo_id":"HP:0001508"},{"id":"hpo:HP:0002059","type":"Phenotype","label":"Cerebral atrophy","hpo_id":"HP:0002059"},{"id":"hpo:HP:0001272","type":"Phenotype","label":"Cerebellar atrophy","hpo_id":"HP:0001272"},{"id":"finding:40812465:2","type":"Finding","label":"In a 6-year-old Afghan girl with DEE born to consanguineous parents, Dehghanzad et al. (2025) used whole-exome sequencing to identify a novel homozygous frameshift variant in the HECW2 gene (c.3601_3602insT, p.Tyr1201LeufsTer7). Sanger sequencing confirmed the variant. Both parents were unaffected heterozygous carriers. The authors suggested that the variant likely causes nonsense-mediated mRNA decay, resulting in loss of function. They proposed that this mechanism is distinct from the one implicated for the missense variants that cause autosomal dominant disease.","pmid":"40812465","section":"molecular_genetics"},{"id":"variant:HECW2:c.3601_3602inst","type":"Variant","label":"HECW2 c.3601_3602inst / p.Y1201Lfs / p.Y1201fs","gene":"HECW2","keys":["c.3601_3602inst","p.Y1201Lfs","p.Y1201fs"],"omim_name":"HECW2, TYR1201LEUFS"},{"id":"finding:40812465:3","type":"Finding","label":"Dehghanzad et al. (2025) concluded that the homozygous HECW2 frameshift variant in a patient from a consanguineous family was inherited in an autosomal recessive pattern. Both heterozygous carrier parents were clinically unaffected. This contrasts with the usual autosomal dominant inheritance of HECW2-related NDHSAL.","pmid":"40812465","section":"inheritance"}],"edges":[{"src":"paper:35487419","rel":"reports","dst":"finding:35487419:1"},{"src":"finding:35487419:1","rel":"in_section","dst":"section:clinical_features"},{"src":"finding:35487419:1","rel":"mentions_gene","dst":"gene:HECW2","pmid":"35487419"},{"src":"finding:35487419:1","rel":"has_phenotype","dst":"hpo:HP:0001263","pmid":"35487419","present":true,"text":"developmental delay"},{"src":"finding:35487419:1","rel":"has_phenotype","dst":"hpo:HP:0001249","pmid":"35487419","present":true,"text":"intellectual disability"},{"src":"finding:35487419:1","rel":"has_phenotype","dst":"hpo:HP:0001252","pmid":"35487419","present":true,"text":"hypotonia"},{"src":"finding:35487419:1","rel":"has_phenotype","dst":"hpo:HP:0025190","pmid":"35487419","present":true,"text":"generalized tonic-clonic seizures"},{"src":"finding:35487419:1","rel":"has_phenotype","dst":"hpo:HP:0000473","pmid":"35487419","present":true,"text":"persistent tilted head"},{"src":"finding:35487419:1","rel":"asserts_inheritance","dst":"inh:AR","pmid":"35487419"},{"src":"paper:35487419","rel":"reports","dst":"finding:35487419:2"},{"src":"finding:35487419:2","rel":"in_section","dst":"section:molecular_genetics"},{"src":"finding:35487419:2","rel":"mentions_gene","dst":"gene:HECW2","pmid":"35487419"},{"src":"finding:35487419:2","rel":"reports_v