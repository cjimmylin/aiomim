{"seed":{"mim":"621766","entry_type":"phenotype","prefix":"#","title":"SPERMATOGENIC FAILURE 104","alt_titles":[],"symbol":"SPGF104","gene_symbols":[],"seed_pmids":[],"max_year":2025},"nodes":[{"id":"entry","type":"Entry","label":"SPERMATOGENIC FAILURE 104","mim":"621766","entry_type":"phenotype"},{"id":"section:description","type":"Section","label":"description"},{"id":"section:nomenclature","type":"Section","label":"nomenclature"},{"id":"section:cloning_expression","type":"Section","label":"cloning_expression"},{"id":"section:gene_structure","type":"Section","label":"gene_structure"},{"id":"section:clinical_features","type":"Section","label":"clinical_features"},{"id":"section:other_features","type":"Section","label":"other_features"},{"id":"section:biochemical_features","type":"Section","label":"biochemical_features"},{"id":"section:inheritance","type":"Section","label":"inheritance"},{"id":"section:cytogenetics","type":"Section","label":"cytogenetics"},{"id":"section:mapping","type":"Section","label":"mapping"},{"id":"section:heterogeneity","type":"Section","label":"heterogeneity"},{"id":"section:gene_function","type":"Section","label":"gene_function"},{"id":"section:molecular_genetics","type":"Section","label":"molecular_genetics"},{"id":"section:genotype_phenotype_correlations","type":"Section","label":"genotype_phenotype_correlations"},{"id":"section:pathogenesis","type":"Section","label":"pathogenesis"},{"id":"section:diagnosis","type":"Section","label":"diagnosis"},{"id":"section:clinical_management","type":"Section","label":"clinical_management"},{"id":"section:population_genetics","type":"Section","label":"population_genetics"},{"id":"section:evolution","type":"Section","label":"evolution"},{"id":"section:animal_model","type":"Section","label":"animal_model"},{"id":"section:history","type":"Section","label":"history"},{"id":"paper:38073178","type":"Paper","label":"Khan et al. (2025)","pmid":"38073178","year":2025,"content_level":"abstract","relevance":"primary","title":"Genome sequencing of Pakistani families with male infertility identifies deleterious genotypes in SPAG6, CCDC9, TKTL1, TUBA3C, and M1AP."},{"id":"paper:31502483","type":"Paper","label":"Sha et al. (2019)","pmid":"31502483","year":2019,"content_level":"abstract","relevance":"primary","title":"CCDC9 is identified as a novel candidate gene of severe asthenozoospermia."},{"id":"finding:31502483:1","type":"Finding","label":"Sha et al. (2019) reported a man from a consanguineous family who had severe asthenozoospermia. Fewer than 1% of the spermatozoa in his ejaculate were motile, and his spermatozoa showed severely damaged morphology and ultrastructure.","pmid":"31502483","section":"clinical_features"},{"id":"gene:CCDC9","type":"Gene","label":"CCDC9"},{"id":"hpo:HP:0012207","type":"Phenotype","label":"Reduced sperm motility","hpo_id":"HP:0012207"},{"id":"hpo:HP:0012864","type":"Phenotype","label":"Abnormal sperm morphology","hpo_id":"HP:0012864"},{"id":"inh:AR","type":"Inheritance","label":"Autosomal recessive","hpo_id":"HP:0000007"},{"id":"finding:31502483:2","type":"Finding","label":"In a man with severe asthenozoospermia from a consanguineous family, Sha et al. (2019) identified a novel homozygous variant in the CCDC9 gene (g.47763960C>T, NM_015603.3), which causes a ser109-to-leu (S109L) substitution. In silico analysis predicted the variant to be highly pathogenic. CCDC9 protein levels were significantly reduced in the patient's spermatozoa. The authors suggested that CCDC9 may be a novel pathogenic gene for severe asthenozoospermia.","pmid":"31502483","section":"molecular_genetics"},{"id":"variant:CCDC9:g.47763960C>T","type":"Variant","label":"CCDC9 g.47763960C>T / p.S109L","gene":"CCDC9","keys":["g.47763960C>T","p.S109L"],"omim_name":"CCDC9, SER109LEU"},{"id":"finding:38073178:1","type":"Finding","label":"Khan et al. (2025) performed whole genome sequencing on 26 individuals (3 to 5 per family) from 7 large families from rural Pakistan with clinically diagnosed male infertility, 5 of which had a history of consanguinity. They identified plausible genetic causes in 5 of the 7 families (71%): a homozygous 10-kb deletion of exon 2 of M1AP, biallelic missense substitutions in SPAG6, CCDC9, and TUBA3C, and an in-frame hemizygous deletion in TKTL1.","pmid":"38073178","section":"molecular_genetics"},{"id":"gene:SPAG6","type":"Gene","label":"SPAG6"},{"id":"gene:TUBA3C","type":"Gene","label":"TUBA3C"},{"id":"gene:TKTL1","type":"Gene","label":"TKTL1"},{"id":"gene:M1AP","type":"Gene","label":"M1AP"},{"id":"hpo:HP:0003251","type":"Phenotype","label":"Male infertility","hpo_id":"HP:0003251"},{"id":"finding:38073178:2","type":"Finding","label":"In a consanguineous Pakistani family with male infertility, Khan et al. (2025) identified biallelic missense substitutions in the SPAG6 gene by whole genome sequencing.","pmid":"38073178","section":"molecular_genetics"},{"id":"variant:SPAG6:raw:biallelic missense substitution","type":"Variant","label":"SPAG6 biallelic missense substitution","gene":"SPAG6","keys":["raw:biallelic missense substitution"],"omim_name":"SPAG6"},{"id":"finding:38073178:3","type":"Finding","label":"In a Pakistani family with male infertility, Khan et al. (2025) identified biallelic missense substitutions in the CCDC9 gene by whole genome sequencing.","pmid":"38073178","section":"molecular_genetics"},{"id":"variant:CCDC9:raw:biallelic missense substitution","type":"Variant","label":"CCDC9 biallelic missense substitution","gene":"CCDC9","keys":["raw:biallelic missense substitution"],"omim_name":"CCDC9"},{"id":"finding:38073178:4","type":"Finding","label":"In a Pakistani family with male infertility, Khan et al. (2025) identified biallelic missense substitutions in the TUBA3C gene by whole genome sequencing.","pmid":"38073178","section":"molecular_genetics"},{"id":"variant:TUBA3C:raw:biallelic missense substitution","type":"Variant","label":"TUBA3C biallelic missense substitution","gene":"TUBA3C","keys":["raw:biallelic missense substitution"],"omim_name":"TUBA3C"},{"id":"finding:38073178:5","type":"Finding","label":"In a Pakistani family with male infertility, Khan et al. (2025) identified an in-frame hemizygous deletion in the X-linked TKTL1 gene by whole genome sequencing.","pmid":"38073178","section":"molecular_genetics"},{"id":"variant:TKTL1:raw:in-frame hemizygous deletion","type":"Variant","label":"TKTL1 in-frame hemizygous deletion","gene":"TKTL1","keys":["raw:in-frame hemizygous deletion"],"omim_name":"TKTL1"},{"id":"inh:XLR","type":"Inheritance","label":"X-linked recessive","hpo_id":"HP:0001419"},{"id":"finding:38073178:6","type":"Finding","label":"In a Pakistani family with male infertility, Khan et al. (2025) identified a homozygous 10-kb deletion that included exon 2 of the M1AP gene. They noted that this single-exon deletion would have been undetectable by whole exome sequencing.","pmid":"38073178","section":"molecular_genetics"},{"id":"variant:M1AP:raw:homozygous 10 kb deletion of exon 2","type":"Variant","label":"M1AP homozygous 10 kb deletion of exon 2","gene":"M1AP","keys":["raw:homozygous 10 kb deletion of exon 2"],"omim_name":"M1AP"}],"edges":[{"src":"paper:31502483","rel":"reports","dst":"finding:31502483:1"},{"src":"finding:31502483:1","rel":"in_section","dst":"section:clinical_features"},{"src":"finding:31502483:1","rel":"mentions_gene","dst":"gene:CCDC9","pmid":"31502483"},{"src":"finding:31502483:1","rel":"has_phenotype","dst":"hpo:HP:0012207","pmid":"31502483","present":true,"text":"severe asthenozoospermia"},{"src":"finding:31502483:1","rel":"has_phenotype","dst":"hpo:HP:0012864","pmid":"31502483","present":true,"text":"abnormal sperm morphology and ultrastructure"},{"src":"finding:31502483:1","rel":"asserts_inheritance","dst":"inh:AR","pmid":"31502483"},{"src":"paper:31502483","rel":"reports","dst":"finding:31502483:2"},{"src":"finding:31502483:2","rel":"in_section","dst":"section:molecular_genetics"},{"src":"finding:31502483:2","rel":"mentions