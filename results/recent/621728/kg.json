evance":"not_relevant","title":"TECTB Variants Reveal Tectorial Membrane Vulnerability in Dominant Non-Syndromic Hearing Loss."},{"id":"paper:17220887","type":"Paper","label":"Russell et al. (2007)","pmid":"17220887","year":2007,"content_level":"fulltext","relevance":"supporting","title":"Sharpened cochlear tuning in a mouse with a genetically modified tectorial membrane."},{"id":"finding:17220887:1","type":"Finding","label":"Russell et al. (2007) made Tectb-null mice by deleting exons 1-4 of the Tectb gene through gene targeting. In homozygous mice, Tectb protein was absent from the tectorial membrane, and the striated-sheet matrix was completely missing along its whole length. The tectorial membrane stayed attached to the organ of Corti, and the distribution of Tecta and otogelin was unchanged. Hensen's stripe was absent in the basal coil. In the apical coil, the tectorial membrane was about twice as thick and twice the cross-sectional area of controls, its marginal band was missing, and its peripheral edge was frayed. Hair bundle structure was normal.","pmid":"17220887","section":"animal_model"},{"id":"gene:TECTB","type":"Gene","label":"TECTB"},{"id":"inh:AR","type":"Inheritance","label":"Autosomal recessive","hpo_id":"HP:0000007"},{"id":"finding:17220887:2","type":"Finding","label":"Russell et al. (2007) found that Tectb -/- mice had a distinct hearing loss for frequencies below about 20 kHz. In this low-frequency range, DPOAE levels were 20-30 dB below those of wild type mice. Above 20 kHz, neural sensitivity was close to normal. In the high-frequency basal cochlea, both basilar membrane tuning and neural tuning were markedly sharper than in wild type (mean Q10dB 18.9 vs 9.6). The authors attributed this to a reduction in the acting mass of the tectorial membrane and less spread of excitation along the cochlea. They concluded that Tectb is essential for low-frequency hearing.","pmid":"17220887","section":"animal_model"},{"id":"hpo:HP:0008542","type":"Phenotype","label":"Low-frequency hearing loss","hpo_id":"HP:0008542"}],"edges":[{"src":"paper:17220887","rel":"reports","dst":"finding:17220887:1"},{"src":"finding:17220887:1","rel":"in_section","dst":"section:animal_model"},{"src":"finding:17220887:1","rel":"mentions_gene","dst":"gene:TECTB","pmid":"17220887"},{"src":"finding:17220887:1","rel":"asserts_inheritance","dst":"inh:AR","pmid":"17220887"},{"src":"paper:17220887","rel":"reports","dst":"finding:17220887:2"},{"src":"finding:17220887:2","rel":"in_section","dst":"section:animal_model"},{"src":"finding:17220887:2","rel":"mentions_gene","dst":"gene:TECTB","pmid":"17220887"},{"src":"finding:17220887:2","rel":"has_phenotype","dst":"hpo:HP:0008542","pmid":"17220887","present":true,"text":"low-frequency hearing loss"},{"src":"finding:17220887:2","rel":"asserts_inheritance","dst":"inh:AR","pmid":"17220887"},{"src":"entry","rel":"inheritance","dst":"inh:AR","pmids":["17220887"]},{"src":"entry","rel":"has_phenotype","dst":"hpo:HP:0008542","pmids":["17220887"],"absent_in":[]}],"stats":{"nodes":{"Entry":1,"Section":21,"Paper":2,"Finding":2,"Gene":1,"Inheritance":1,"Phenotype":1},"edges":{"reports":2,"in_section":2,"mentions_gene":2,"asserts_inheritance":2,"has_phenotype":2,"inheritance":1}}}