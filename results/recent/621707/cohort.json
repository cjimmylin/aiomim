","inheritance":"AD","previously_reported":"","mixed_genotypes":false,"quotes":["Another illustrative example is family XVII, in which two affected brothers (P18, P19) carried the Arg179His mutation","P18 has dysmorphism (micrognathia, high anterior hairline, low-set ears), cryptorchidism, inguinal hernia, pelvic kidney, childhood failure to thrive with adult short stature, arthritis, gout, suspected osteoporosis, chronic diarrhea, sensorineural hearing loss, compensated hypothyroidism","anxiety, depression, asthma, recurrent infections (otitis media, croup, pharyngitis, bronchitis, pneumonia), and dysgammaglobulinemia (low serum IgM, poor vaccine titers)."],"quote_grounding":[1.0,1.0,1.0],"followup_of":"","genotype_mode":"AD","genotype_reason":"single heterozygous variant; mode as stated for the family"},{"id":"R:40926810:4","pmid":"40926810","label":"P19","kind":"individual","family":"family XVII","n_affected":1,"n_families":1,"sex":"male","ancestry":"","consanguinity":"not_stated","onset":"prenatal","age_last":"deceased","phenotypes":[{"text":"micrognathia","hpo_label":"Micrognathia","hpo_id":"HP:0000347","present":true,"n_with":null,"n_assessed":null,"some_only":false,"other_cause":false},{"text":"high anterior hairline","hpo_label":"High anterior hairline","hpo_id":"HP:0009890","present":true,"n_with":null,"n_assessed":null,"some_only":false,"other_cause":false},{"text":"low-set ears","hpo_label":"Low-set ears","hpo_id":"HP:0000369","present":true,"n_with":null,"n_assessed":null,"some_only":false,"other_cause":false},{"text":"cryptorchidism","hpo_label":"Cryptorchidism","hpo_id":"HP:0000028","present":true,"n_with":null,"n_assessed":null,"some_only":false,"other_cause":false},{"text":"inguinal hernia","hpo_label":"Inguinal hernia","hpo_id":"HP:0000023","present":true,"n_with":null,"n_assessed":null,"some_only":false,"other_cause":false},{"text":"deviated nasal septum","hpo_label":"Deviated nasal septum","hpo_id":"HP:0004411","present":true,"n_with":null,"n_asse