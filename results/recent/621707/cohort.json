ease."],"quote_grounding":[1.0,1.0],"followup_of":"","genotype_mode":"AD","genotype_reason":"single heterozygous variant; mode as stated for the family"},{"id":"R:40926810:3","pmid":"40926810","label":"P18","kind":"individual","family":"family XVII","n_affected":1,"n_families":1,"sex":"male","ancestry":"","consanguinity":"not_stated","onset":"childhood","age_last":"adult","phenotypes":[{"text":"micrognathia","hpo_label":"Micrognathia","hpo_id":"HP:0000347","present":true,"n_with":null,"n_assessed":null,"some_only":false,"other_cause":false},{"text":"high anterior hairline","hpo_label":"High anterior hairline","hpo_id":"HP:0009890","present":true,"n_with":null,"n_assessed":null,"some_only":false,"other_cause":false},{"text":"low-set ears","hpo_label":"Low-set ears","hpo_id":"HP:0000369","present":true,"n_with":null,"n_assessed":null,"some_only":false,"other_cause":false},{"text":"cryptorchidism","hpo_label":"Cryptorchidism","hpo_id":"HP:0000028","present":true,"n_with":null,"n_assessed":null,"some_only":false,"other_cause":false},{"text":"inguinal hernia","hpo_label":"Inguinal hernia","hpo_id":"HP:0000023","present":true,"n_with":null,"n_assessed":null,"some_only":false,"other_cause":false},{"text":"pelvic kidney","hpo_label":"Pelvic kidney","hpo_id":"HP:0000125","present":true,"n_with":null,"n_assessed":null,"some_only":false,"other_cause":false},{"text":"childhood failure to thrive","hpo_label":"Failure to thrive","hpo_id":"HP:0001508","present":true,"n_with":null,"n_assessed":null,"some_only":false,"other_cause":false},{"text":"adult short stature","hpo_label":"Short stature","hpo_id":"HP:0004322","present":true,"n_with":null,"n_assessed":null,"some_only":false,"other_cause":false},{"text":"arthritis","hpo_label":"Arthritis","hpo_id":"HP:0001369","present":true,"n_with":null,"n_assessed":null,"some_only":false,"other_cause":false},{"text":"gout","hpo_label":"Gout","hpo_id":"HP:0001997","present":true,"n_with":null,"n_assessed":null,"some_only":false,"other_cause":