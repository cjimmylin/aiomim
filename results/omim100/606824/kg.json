{"seed":{"mim":"606824","entry_type":"phenotype","prefix":"#","title":"GLUCOSE/GALACTOSE MALABSORPTION","alt_titles":["MONOSACCHARIDE MALABSORPTION","DIARRHEA 16"],"symbol":"GGM","gene_symbols":[],"seed_pmids":[],"max_year":2011},"nodes":[{"id":"entry","type":"Entry","label":"GLUCOSE/GALACTOSE MALABSORPTION","mim":"606824","entry_type":"phenotype"},{"id":"section:description","type":"Section","label":"description"},{"id":"section:nomenclature","type":"Section","label":"nomenclature"},{"id":"section:cloning_expression","type":"Section","label":"cloning_expression"},{"id":"section:gene_structure","type":"Section","label":"gene_structure"},{"id":"section:clinical_features","type":"Section","label":"clinical_features"},{"id":"section:other_features","type":"Section","label":"other_features"},{"id":"section:biochemical_features","type":"Section","label":"biochemical_features"},{"id":"section:inheritance","type":"Section","label":"inheritance"},{"id":"section:cytogenetics","type":"Section","label":"cytogenetics"},{"id":"section:mapping","type":"Section","label":"mapping"},{"id":"section:heterogeneity","type":"Section","label":"heterogeneity"},{"id":"section:gene_function","type":"Section","label":"gene_function"},{"id":"section:molecular_genetics","type":"Section","label":"molecular_genetics"},{"id":"section:genotype_phenotype_correlations","type":"Section","label":"genotype_phenotype_correlations"},{"id":"section:pathogenesis","type":"Section","label":"pathogenesis"},{"id":"section:diagnosis","type":"Section","label":"diagnosis"},{"id":"section:clinical_management","type":"Section","label":"clinical_management"},{"id":"section:population_genetics","type":"Section","label":"population_genetics"},{"id":"section:evolution","type":"Section","label":"evolution"},{"id":"section:animal_model","type":"Section","label":"animal_model"},{"id":"section:history","type":"Section","label":"history"},{"id":"paper:20486940","type":"Paper","label":"Xin and Wang (2011)","pmid":"20486940","year":2011,"content_level":"abstract","relevance":"primary","title":"Multiple sequence variations in SLC5A1 gene are associated with glucose-galactose malabsorption in a large cohort of Old Order Amish."},{"id":"paper:14259267","type":"Paper","label":"ANDERSON et al. (1965)","pmid":"14259267","year":1965,"content_level":"title","relevance":"primary","title":"AN INBORN DEFECT OF INTESTINAL ABSORPTION OF CERTAIN MONOSACCHARIDES."},{"id":"paper:8985845","type":"Paper","label":"Abdullah et al. (1996)","pmid":"8985845","year":1996,"content_level":"abstract","relevance":"primary","title":"Congenital glucose-galactose malabsorption in Arab children."},{"id":"paper:8844006","type":"Paper","label":"Martín et al. (1996)","pmid":"8844006","year":1996,"content_level":"abstract","relevance":"supporting","title":"Prenatal identification of a heterozygous status in two fetuses at risk for glucose-galactose malabsorption."},{"id":"paper:8563765","type":"Paper","label":"Martín et al. (1996)","pmid":"8563765","year":1996,"content_level":"abstract","relevance":"primary","title":"Defects in Na+/glucose cotransporter (SGLT1) trafficking and function cause glucose-galactose malabsorption."},{"id":"paper:8244393","type":"Paper","label":"Turk et al. (1993)","pmid":"8244393","year":1993,"content_level":"abstract","relevance":"supporting","title":"Assignment of the human Na+/glucose cotransporter gene SGLT1 to chromosome 22q13.1."},{"id":"paper:5581590","type":"Paper","label":"Lebenthal et al. (1971)","pmid":"5581590","year":1971,"content_level":"title","relevance":"primary","title":"Glucose-galactose malabsorption in an Oriental-Iraqui Jewish family."},{"id":"paper:5438804","type":"Paper","label":"Meeuwisse (1970)","pmid":"5438804","year":1970,"content_level":"title","relevance":"supporting","title":"Glucose-galactose malabsorption. Studies on renal glucosuria."},{"id":"paper:5415683","type":"Paper","label":"Elsas et al. (1970)","pmid":"5415683","year":1970,"content_level":"abstract","relevance":"primary","title":"Renal and intestinal hexose transport in familial glucose-galactose malabsorption."},{"id":"paper:4717580","type":"Paper","label":"Elsas and Lambe (1973)","pmid":"4717580","year":1973,"content_level":"title","relevance":"supporting","title":"Familial glucose-galactose malabsorption: remission of glucose intolerance."},{"id":"paper:2008213","type":"Paper","label":"Turk et al. (1991)","pmid":"2008213","year":1991,"content_level":"abstract","relevance":"primary","title":"Glucose/galactose malabsorption caused by a defect in the Na+/glucose cotransporter."},{"id":"finding:14259267:1","type":"Finding","label":"ANDERSON et al. (1965) reported an inborn defect of intestinal absorption of certain monosaccharides.","pmid":"14259267","section":"clinical_features"},{"id":"hpo:HP:0002024","type":"Phenotype","label":"Malabsorption","hpo_id":"HP:0002024"},{"id":"finding:5415683:1","type":"Finding","label":"Elsas et al. (1970) studied a 3-year-old girl with congenital glucose-galactose malabsorption. In vitro, her jejunal mucosa could not concentrate glucose at any point in a 60-minute incubation. Renal glucose titration showed a partial defect in renal glucose reabsorption.","pmid":"5415683","section":"clinical_features"},{"id":"hpo:HP:0003076","type":"Phenotype","label":"Glycosuria","hpo_id":"HP:0003076"},{"id":"finding:5415683:2","type":"Finding","label":"Elsas et al. (1970) found that normal human jejunal mucosa transported glucose against a concentration gradient; transport was saturable, depended on sodium and energy, and showed competitive inhibition. Mucosa from 6 normal controls and from the proband's asymptomatic 5-year-old brother concentrated glucose to 16 times the medium concentration. Fructose was accumulated similarly in all subjects.","pmid":"5415683","section":"biochemical_features"},{"id":"finding:5415683:3","type":"Finding","label":"Elsas et al. (1970) found impaired intestinal glucose transport in both parents and a half sister of the proband, with values between those of normal controls and the proband. In these heterozygotes, glucose influx was impaired while efflux was the same as in controls. Kinetic analysis showed a reduced capacity (Vmax) with normal affinity (Km), and the authors concluded that heterozygotes can be detected.","pmid":"5415683","section":"biochemical_features"},{"id":"inh:AR","type":"Inheritance","label":"Autosomal recessive","hpo_id":"HP:0000007"},{"id":"finding:5415683:4","type":"Finding","label":"Elsas et al. (1970) concluded that familial glucose-galactose malabsorption is inherited as an autosomal recessive trait. They also concluded that heterozygotes are detectable because their capacity for glucose transport is reduced.","pmid":"5415683","section":"inheritance"},{"id":"finding:5415683:5","type":"Finding","label":"Elsas et al. (1970) concluded that the absence of intestinal glucose transport in glucose-galactose malabsorption is accompanied by partial impairment of renal glucose transport. The proband's brother had a renal titration curve similar to those of 7 normal volunteers.","pmid":"5415683","section":"pathogenesis"},{"id":"finding:5438804:1","type":"Finding","label":"Meeuwisse (1970) studied renal glucosuria in glucose-galactose malabsorption.","pmid":"5438804","section":"biochemical_features"},{"id":"finding:5581590:1","type":"Finding","label":"Lebenthal et al. (1971) reported glucose-galactose malabsorption in an Oriental-Iraqi Jewish family.","pmid":"5581590","section":"clinical_features"},{"id":"hpo:HP:0001952","type":"Phenotype","label":"Glucose intolerance","hpo_id":"HP:0001952"},{"id":"finding:4717580:1","type":"Finding","label":"Elsas and Lambe (1973) reported familial glucose-galactose malabsorption in which the glucose intolerance went into remission.","pmid":"4717580","section":"clinical_features"},{"id":"finding:2008213:1","type":"Finding","label":"Turk et al. (1991) described glucose/galactose malabsorption as an autosomal recessive disease that manifests within the first weeks of life and is characterized by a selective failure to absorb dietary glucose and galactose from the intestine. The resulting severe diarrhea and dehydration are usually fatal unless these sugars are removed from the diet.","pmid":"2008213","section":"description"},{"id":"hpo:HP:0002014","type":"Phenotype","label":"Diarrhea","hpo_id":"HP:0002014"},{"id":"hpo:HP:0001944","type":"Phenotype","label":"Dehydration","hpo_id":"HP:0001944"},{"id":"finding:2008213:2","type":"Finding","label":"Turk et al. (1991) noted that the severe diarrhea and dehydration of GGM are usually fatal unless glucose and galactose are eliminated from the diet.","pmid":"2008213","section":"clinical_management"},{"id":"finding:2008213:3","type":"Finding","label":"Turk et al. (1991) noted that intestinal biopsies from GGM patients had shown a specific defect in Na(+)-dependent glucose absorption in the brush border. Normal absorption is mediated by the Na+/glucose cotransporter in the brush border membrane, which is encoded by SGLT1 on distal chromosome 22q.","pmid":"2008213","section":"pathogenesis"},{"id":"gene:SLC5A1","type":"Gene","label":"SLC5A1"},{"id":"finding:2008213:4","type":"Finding","label":"In members of a family with GGM, Turk et al. (1991) used PCR to amplify SGLT1 cDNA and genomic DNA and found a single missense mutation in SGLT1 that cosegregated with the GGM phenotype. In Xenopus oocytes injected with cRNA carrying the mutation, Na(+)-dependent glucose transport was completely lost.","pmid":"2008213","section":"molecular_genetics"},{"id":"variant:SLC5A1:raw:single missense mutation in sglt1","type":"Variant","label":"SLC5A1 single missense mutation in SGLT1","gene":"SLC5A1","keys":["raw:single missense mutation in sglt1"],"omim_name":"SLC5A1"},{"id":"finding:8244393:1","type":"Finding","label":"Turk et al. (1993) used fluorescence in situ hybridization with a cosmid probe to refine the localization of the SGLT1 gene, which encodes the intestinal Na+/glucose cotransporter, from the distal long arm of chromosome 22 (22q11.2-qter) to 22q13.1.","pmid":"8244393","section":"mapping"},{"id":"finding:8244393:2","type":"Finding","label":"Turk et al. (1993) noted that in 2 patients with autosomal recessive glucose/galactose malabsorption, the cause was a missense mutation in SGLT1, asp28-to-asn (D28N), which was shown in vitro to eliminate SGLT1 transport activity.","pmid":"8244393","section":"molecular_genetics"},{"id":"variant:SLC5A1:p.D28","type":"Variant","label":"SLC5A1 p.D28 / p.D28N","gene":"SLC5A1","keys":["p.D28","p.D28N"],"omim_name":"SLC5A1, ASP28ASN"},{"id":"finding:8563765:1","type":"Finding","label":"Martín et al. (1996) stated that glucose-galactose malabsorption (GGM) is caused by a defect in the intestinal brush border Na+/glucose cotransporter SGLT1. The disorder presents in the neonatal period with diarrhea, which is fatal unless glucose and galactose are removed from the diet.","pmid":"8563765","section":"description"},{"id":"finding:8563765:2","type":"Finding","label":"Martín et al. (1996) screened the SGLT1 gene in 30 new patients with GGM. They used a heterologous expression system to link the mutations to the phenotype, and concluded that defects in SGLT1 trafficking and function cause the disorder.","pmid":"8563765","section":"molecular_genetics"},{"id":"finding:8844006:1","type":"Finding","label":"Martín et al. (1996) performed prenatal screening for GGM in 2 subsequent pregnancies in a large consanguineous family in which 2 proband sibs with GGM had a missense mutation (D28N) in SGLT1. Exon 1 of SGLT1 was PCR-amplified from fetal genomic DNA and screened for D28N by EcoRV restriction digestion; the proband's sib was heterozygous and a cousin was not a carrier. Both children remained healthy without diarrheal symptoms at 2 years of age.","pmid":"8844006","section":"diagnosis"},{"id":"finding:8985845:1","type":"Finding","label":"Abdullah et al. (1996) described 8 children from 8 different families with glucose-galactose malabsorption; 6 were Saudi Arabs and 2 were of other Arab nationalities. Mean age at presentation was 10.6 months, and the children had chronic watery diarrhea present since birth and failure to thrive. One child had a renal stone at the first visit, and another was found to have one on follow-up.","pmid":"8985845","section":"clinical_features"},{"id":"hpo:HP:0002028","type":"Phenotype","label":"Chronic diarrhea","hpo_id":"HP:0002028"},{"id":"hpo:HP:0001508","type":"Phenotype","label":"Failure to thrive","hpo_id":"HP:0001508"},{"id":"hpo:HP:0000787","type":"Phenotype","label":"Kidney stone","hpo_id":"HP:0000787"},{"id":"finding:8985845:2","type":"Finding","label":"Abdullah et al. (1996) confirmed the diagnosis of glucose-galactose malabsorption with laboratory tests, including small-bowel biopsy, histology, and small-bowel enzyme assay.","pmid":"8985845","section":"diagnosis"},{"id":"finding:8985845:3","type":"Finding","label":"Abdullah et al. (1996) reported that all 8 children with glucose-galactose malabsorption responded clinically to a fructose-based formula and were thriving at follow-up.","pmid":"8985845","section":"clinical_management"},{"id":"finding:20486940:1","type":"Finding","label":"Xin and Wang (2011) reported 33 patients with glucose-galactose malabsorption from a large Old Order Amish pedigree. All affected individuals presented with classic watery diarrhea and dehydration; increased bowel sounds, distended abdomen, vigorous nursing despite illness, and irritability and apathy were also noted at initial presentation.","pmid":"20486940","section":"clinical_features"},{"id":"hpo:HP:0030143","type":"Phenotype","label":"Hyperactive bowel sounds","hpo_id":"HP:0030143"},{"id":"hpo:HP:0003270","type":"Phenotype","label":"Abdominal distention","hpo_id":"HP:0003270"},{"id":"hpo:HP:0000737","type":"Phenotype","label":"Irritability","hpo_id":"HP:0000737"},{"id":"hpo:HP:0000741","type":"Phenotype","label":"Apathy","hpo_id":"HP:0000741"},{"id":"finding:20486940:2","type":"Finding","label":"Xin and Wang (2011) observed that patients who were correctly diagnosed and adequately managed showed immediate cessation of diarrhea and rapid rehydration, followed by normal growth and development, whereas a prolonged clinical course followed if the disease was not recognized.","pmid":"20486940","section":"clinical_management"},{"id":"finding:20486940:3","type":"Finding","label":"In 33 Old Order Amish patients with GGM, Xin and Wang (2011) sequenced the 15 protein-coding exons and exon-intron boundaries of SLC5A1 and identified homozygosity for four missense mutations, including c.152A>G (p.N51S), which co-segregated with the phenotype in all affected individuals.","pmid":"20486940","section":"molecular_genetics"},{"id":"variant:SLC5A1:c.152A>G","type":"Variant","label":"SLC5A1 c.152A>G / p.N51S","gene":"SLC5A1","keys":["c.152A>G","p.N51S"],"omim_name":"SLC5A1, ASN51SER"},{"id":"finding:20486940:4","type":"Finding","label":"Xin and Wang (2011) identified a homozygous c.1231G>A (p.A411T) missense mutation in SLC5A1, one of four homozygous missense variants co-segregating with GGM in all 33 affected Old Order Amish individuals.","pmid":"20486940","section":"molecular_genetics"},{"id":"variant:SLC5A1:c.1231G>A","type":"Variant","label":"SLC5A1 c.1231G>A / p.A411T","gene":"SLC5A1","keys":["c.1231G>A","p.A411T"],"omim_name":"SLC5A1, ALA411THR"},{"id":"finding:20486940:5","type":"Finding","label":"Xin and Wang (2011) identified a homozygous c.1673G>A (p.R558H) missense mutation in SLC5A1, one of four homozygous missense variants co-segregating with GGM in all 33 affected Old Order Amish individuals.","pmid":"20486940","section":"molecular_genetics"},{"id":"variant:SLC5A1:c.1673G>A","type":"Variant","label":"SLC5A1 c.1673G>A / p.R558H","gene":"SLC5A1","keys":["c.1673G>A","p.R558H"],"omim_name":"SLC5A1, ARG558HIS"},{"id":"finding:20486940:6","type":"Finding","label":"Xin and Wang (2011) identified a homozygous c.1845C>G (p.H615Q) missense mutation in SLC5A1, one of four homozygous missense variants co-segregating with GGM in all 33 affected Old Order Amish individuals.","pmid":"20486940","section":"molecular_genetics"},{"id":"variant:SLC5A1:c.1845C>G","type":"Variant","label":"SLC5A1 c.1845C>G / p.H615Q","gene":"SLC5A1","keys":["c.1845C>G","p.H615Q"],"omim_name":"SLC5A1, HIS615GLN"},{"id":"finding:20486940:7","type":"Finding","label":"Xin and Wang (2011) suggested a founder effect for the SLC5A1 mutations associated with GGM in the Amish and proposed population-specific genetic testing to allow early diagnosis, which they considered critical for a favorable outcome.","pmid":"20486940","section":"population_genetics"}],"edges":[{"src":"paper:14259267","rel":"reports","dst":"finding:14259267:1"},{"src":"finding:14259267:1","rel":"in_section","dst":"section:clinical_features"},{"src":"finding:14259267:1","rel":"has_phenotype","dst":"hpo:HP:0002024","pmid":"14259267","present":true,"text":"intestinal monosaccharide malabsorption"},{"src":"paper:5415683","rel":"reports","dst":"finding:5415683:1"},{"src":"finding:5415683:1","rel":"in_section","dst":"section:clinical_features"},{"src":"finding:5415683:1","rel":"has_phenotype","dst":"hpo:HP:0002024","pmid":"5415683","present":true,"text":"glucose-galactose malabsorption"},{"src":"finding:5415683:1","rel":"has_phenotype","dst":"hpo:HP:0003076","pmid":"5415683","present":true,"text":"partial defect in renal glucose reabsorption"},{"src":"paper:5415683","rel":"reports","dst":"finding:5415683:2"},{"src":"finding:5415683:2","rel":"in_section","dst":"section:biochemical_features"},{"src":"paper:5415683","rel":"reports","dst":"finding:5415683:3"},{"src":"finding:5415683:3","rel":"in_section","dst":"section:biochemical_features"},{"src":"finding:5415683:3","rel":"asserts_inheritance","dst":"inh:AR","pmid":"5415683"},{"src":"paper:5415683","rel":"reports","dst":"finding:5415683:4"},{"src":"finding:5415683:4","rel":"in_section","dst":"section:inh