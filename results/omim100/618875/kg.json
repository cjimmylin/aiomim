el":"has_phenotype","dst":"hpo:HP:0002119","pmids":["32100099"],"absent_in":[]},{"src":"entry","rel":"has_phenotype","dst":"hpo:HP:0002500","pmids":["32100099"],"absent_in":[]},{"src":"entry","rel":"has_phenotype","dst":"hpo:HP:0002529","pmids":["32100099"],"absent_in":["28459434"]},{"src":"entry","rel":"has_phenotype","dst":"hpo:HP:0002171","pmids":["28459434","32100099"],"absent_in":[]},{"src":"entry","rel":"has_phenotype","dst":"hpo:HP:0007305","pmids":["32100099"],"absent_in":["28459434"]},{"src":"entry","rel":"has_phenotype","dst":"hpo:HP:6000717","pmids":["32100099"],"absent_in":[]},{"src":"entry","rel":"has_phenotype","dst":"hpo:HP:0001270","pmids":["28459434"],"absent_in":[]},{"src":"hpo:HP:0034295","rel":"is_a","dst":"hpo:HP:0002500"},{"src":"hpo:HP:0002514","rel":"is_a","dst":"hpo:HP:0430048"}],"stats":{"nodes":{"Entry":1,"Section":21,"Paper":3,"Finding":14,"Gene":3,"Phenotype":16,"PhenotypeText":2,"Inheritance":1,"Variant":2},"edges":{"reports":14,"in_section":14,"mentions_gene":16,"has_phenotype":41,"asserts_inheritance":6,"reports_variant":2,"in_gene":2,"caused_by":1,"has_variant":2,"inheritance":1,"is_a":2}}}