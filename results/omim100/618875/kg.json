 loss"},{"src":"finding:32100099:3","rel":"has_phenotype","dst":"hpo:HP:0002171","pmid":"32100099","present":true,"frequency":"1/1","text":"reactive gliosis"},{"src":"finding:32100099:3","rel":"has_phenotype","dst":"hpo:HP:0007305","pmid":"32100099","present":true,"frequency":"1/1","text":"reduced myelin"},{"src":"finding:32100099:3","rel":"has_phenotype","dst":"hpo:HP:6000717","pmid":"32100099","present":true,"frequency":"1/1","text":"axonal spheroids"},{"src":"paper:32100099","rel":"reports","dst":"finding:32100099:4"},{"src":"finding:32100099:4","rel":"in_section","dst":"section:molecular_genetics"},{"src":"finding:32100099:4","rel":"mentions_gene","dst":"gene:NRROS","pmid":"32100099"},{"src":"finding:32100099:4","rel":"reports_variant","dst":"variant:NRROS:c.1777C>T","pmid":"32100099","zygosity":"homozygous","origin":"inherited","as_reported":"c.1777C > T/p.(Gln593*)"},{"src":"variant:NRROS:c.1777C>T","rel":"in_gene","dst":"gene:NRROS"},{"src":"finding:32100099:4","rel":"asserts_inheritance","dst":"inh:AR","pmid":"32100099"},{"src":"paper:32100099","rel":"reports","dst":"finding:32100099:5"},{"src":"finding:32100099:5","rel":"in_section","dst":"section:molecular_genetics"},{"src":"finding:32100099:5","rel":"mentions_gene","dst":"gene:NRROS","pmid":"32100099"},{"src":"finding:32100099:5","rel":"reports_variant","dst":"variant:NRROS:c.1257del","pmid":"32100099","zygosity":"homozygous","origin":"inherited","as_reported":"c.1257del/p.(Gly420AlafsTer14)"},{"src":"variant:NRROS:c.1257del","rel":"in_gene","dst":"gene:NRROS"},{"src":"finding:32100099:5","rel":"asserts_inheritance","dst":"inh:AR","pmid":"32100099"},{"src":"paper:32100099","rel":"reports","dst":"finding:32100099:6"},{"src":"finding:32100099:6","rel":"in_section","dst":"section:gene_function"},{"src":"finding:32100099:6","rel":"mentions_gene","dst":"gene:NRROS","pmid":"32100099"},{"src":"paper:32100099","rel":"reports","dst":"finding:32100099:7"},{"src":"finding:32100099:7","rel":"in_section","dst":"sectio