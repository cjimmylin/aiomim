{"seed":{"mim":"615268","entry_type":"phenotype","prefix":"#","title":"CEREBELLAR ATAXIA, IMPAIRED INTELLECTUAL DEVELOPMENT, AND DYSEQUILIBRIUM SYNDROME 4","alt_titles":["CEREBELLAR ATAXIA AND MENTAL RETARDATION WITH OR WITHOUT QUADRUPEDAL LOCOMOTION 4","CEREBELLAR ATAXIA, MENTAL RETARDATION, AND DYSEQUILIBRIUM SYNDROME 4"],"symbol":"CAMRQ4","gene_symbols":[],"seed_pmids":[],"max_year":2022},"nodes":[{"id":"entry","type":"Entry","label":"CEREBELLAR ATAXIA, IMPAIRED INTELLECTUAL DEVELOPMENT, AND DYSEQUILIBRIUM SYNDROME 4","mim":"615268","entry_type":"phenotype"},{"id":"section:description","type":"Section","label":"description"},{"id":"section:nomenclature","type":"Section","label":"nomenclature"},{"id":"section:cloning_expression","type":"Section","label":"cloning_expression"},{"id":"section:gene_structure","type":"Section","label":"gene_structure"},{"id":"section:clinical_features","type":"Section","label":"clinical_features"},{"id":"section:other_features","type":"Section","label":"other_features"},{"id":"section:biochemical_features","type":"Section","label":"biochemical_features"},{"id":"section:inheritance","type":"Section","label":"inheritance"},{"id":"section:cytogenetics","type":"Section","label":"cytogenetics"},{"id":"section:mapping","type":"Section","label":"mapping"},{"id":"section:heterogeneity","type":"Section","label":"heterogeneity"},{"id":"section:gene_function","type":"Section","label":"gene_function"},{"id":"section:molecular_genetics","type":"Section","label":"molecular_genetics"},{"id":"section:genotype_phenotype_correlations","type":"Section","label":"genotype_phenotype_correlations"},{"id":"section:pathogenesis","type":"Section","label":"pathogenesis"},{"id":"section:diagnosis","type":"Section","label":"diagnosis"},{"id":"section:clinical_management","type":"Section","label":"clinical_management"},{"id":"section:population_genetics","type":"Section","label":"population_genetics"},{"id":"section:evolution","type":"Section","label":"evolution"},{"id":"section:animal_model","type":"Section","label":"animal_model"},{"id":"section:history","type":"Section","label":"history"},{"id":"paper:35321980","type":"Paper","label":"Narishige et al. (2022)","pmid":"35321980","year":2022,"content_level":"abstract","relevance":"primary","title":"Two Siblings with Cerebellar Ataxia, Mental Retardation, and Disequilibrium Syndrome 4 and a Novel Variant of ATP8A2."},{"id":"paper:33682124","type":"Paper","label":"Damásio et al. (2021)","pmid":"33682124","year":2021,"content_level":"abstract","relevance":"primary","title":"Congenital ataxia due to novel variant in ATP8A2."},{"id":"paper:33079427","type":"Paper","label":"Mohamadian et al. (2020)","pmid":"33079427","year":2020,"content_level":"fulltext","relevance":"primary","title":"A novel homozygous variant in an Iranian pedigree with cerebellar ataxia, mental retardation, and dysequilibrium syndrome type 4."},{"id":"paper:22892528","type":"Paper","label":"Onat et al. (2013)","pmid":"22892528","year":2013,"content_level":"abstract","relevance":"primary","title":"Missense mutation in the ATPase, aminophospholipid transporter protein ATP8A2 is associated with cerebellar atrophy and quadrupedal locomotion."},{"id":"paper:21885617","type":"Paper","label":"Gulsuner et al. (2011)","pmid":"21885617","year":2011,"content_level":"abstract","relevance":"primary","title":"Homozygosity mapping and targeted genomic sequencing reveal the gene responsible for cerebellar hypoplasia and quadrupedal locomotion in a consanguineous kindred."},{"id":"paper:18544652","type":"Paper","label":"Ozcelik et al. (2008)","pmid":"18544652","year":2008,"content_level":"title","relevance":"supporting","title":"Reply to Herz et al. and Humphrey et al.: Genetic heterogeneity of cerebellar hypoplasia with quadrupedal locomotion."},{"id":"paper:18487453","type":"Paper","label":"Herz et al. (2008)","pmid":"18487453","year":2008,"content_level":"title","relevance":"supporting","title":"\"Devolution\" of bipedality."},{"id":"paper:18483196","type":"Paper","label":"Humphrey et al. (2008)","pmid":"18483196","year":2008,"content_level":"title","relevance":"supporting","title":"Genes and quadrupedal locomotion in humans."},{"id":"paper:18326629","type":"Paper","label":"Ozcelik et al. (2008)","pmid":"18326629","year":2008,"content_level":"abstract","relevance":"background","title":"Mutations in the very low-density lipoprotein receptor VLDLR cause cerebellar hypoplasia and quadrupedal locomotion in humans."},{"id":"finding:18326629:1","type":"Finding","label":"Ozcelik et al. (2008) studied 4 large consanguineous Turkish kindreds with quadrupedal gait (Unertan syndrome). In 2 families (B and C), the phenotype was not linked to chromosome 9p, where VLDLR mutations had been found in families A and D. The authors concluded that hereditary disorders with quadrupedal gait in humans are genetically heterogeneous.","pmid":"18326629","section":"heterogeneity"},{"id":"gene:VLDLR","type":"Gene","label":"VLDLR"},{"id":"hpo:HP:0009878","type":"Phenotype","label":"Cerebellar ataxia associated with quadrupedal gait","hpo_id":"HP:0009878"},{"id":"inh:AR","type":"Inheritance","label":"Autosomal recessive","hpo_id":"HP:0000007"},{"id":"finding:18326629:2","type":"Finding","label":"Ozcelik et al. (2008) described 4 large consanguineous kindreds from Turkey with quadrupedal gait (Unertan syndrome), which they described as a rare phenotype associated with dysarthric speech, mental retardation, and varying degrees of cerebrocerebellar hypoplasia.","pmid":"18326629","section":"clinical_features"},{"id":"hpo:HP:0001260","type":"Phenotype","label":"Dysarthria","hpo_id":"HP:0001260"},{"id":"hpo:HP:0001249","type":"Phenotype","label":"Intellectual disability","hpo_id":"HP:0001249"},{"id":"hpo:HP:0001321","type":"Phenotype","label":"Cerebellar hypoplasia","hpo_id":"HP:0001321"},{"id":"hpo:HP:0002060","type":"Phenotype","label":"Abnormal cerebral morphology","hpo_id":"HP:0002060"},{"id":"finding:18544652:1","type":"Finding","label":"In a reply to Herz et al. and Humphrey et al., Ozcelik et al. (2008) discussed genetic heterogeneity of cerebellar hypoplasia with quadrupedal locomotion.","pmid":"18544652","section":"heterogeneity"},{"id":"finding:21885617:1","type":"Finding","label":"Gulsuner et al. (2011) studied a large consanguineous Turkish family with an extremely rare phenotype of quadrupedal locomotion, mental retardation, and cerebro-cerebellar hypoplasia. Diffusion-weighted imaging and fiber tractography showed morphologic abnormalities of the cerebellum and corpus callosum, particularly atrophy of the superior, middle, and inferior cerebellar peduncles; structural MRI showed additional morphometric abnormalities in cortical areas including the corpus callosum, precentral gyrus, and Brodmann areas BA6, BA44, and BA45.","pmid":"21885617","section":"clinical_features"},{"id":"hpo:HP:0011931","type":"Phenotype","label":"Abnormal cerebellar peduncle morphology","hpo_id":"HP:0011931"},{"id":"hpo:HP:0001273","type":"Phenotype","label":"Abnormal corpus callosum morphology","hpo_id":"HP:0001273"},{"id":"hpo:HP:0002538","type":"Phenotype","label":"Abnormal cerebral cortex morphology","hpo_id":"HP:0002538"},{"id":"finding:21885617:2","type":"Finding","label":"By homozygosity mapping in a large consanguineous Turkish family, Gulsuner et al. (2011) linked the disorder to a 7.1-Mb region of homozygosity on chromosome 17p13.1-p13.3.","pmid":"21885617","section":"mapping"},{"id":"finding:21885617:3","type":"Finding","label":"By targeted sequencing of the entire homozygous region in 3 affected individuals and 2 obligate carriers from a consanguineous Turkish family, Gulsuner et al. (2011) identified a private homozygous missense mutation in WDR81 (P856L) that cosegregated with the condition in the extended family. The mutation lies in a highly conserved region of WDR81, flanked by an N-terminal BEACH domain and C-terminal WD40 beta-propeller domains.","pmid":"21885617","section":"molecular_genetics"},{"id":"gene:WDR81","type":"Gene","label":"WDR81"},{"id":"variant:WDR81:p.P856L","type":"Variant","label":"WDR81 p.P856L","gene":"WDR81","keys":["p.P856L"],"omim_name":"WDR81, PRO856LEU"},{"id":"finding:21885617:4","type":"Finding","label":"Gulsuner et al. (2011) reported that WDR81 is predicted to be a transmembrane protein and is highly expressed in the cerebellum and corpus callosum, particularly in the Purkinje cell layer of the cerebellum.","pmid":"21885617","section":"cloning_expression"},{"id":"finding:21885617:5","type":"Finding","label":"Gulsuner et al. (2011) noted that WDR81 was the third gene, after VLDLR and CA8, implicated in quadrupedal locomotion in humans.","pmid":"21885617","section":"heterogeneity"},{"id":"gene:CA8","type":"Gene","label":"CA8"},{"id":"finding:22892528:1","type":"Finding","label":"Onat et al. (2013) studied a consanguineous Turkish family in which 4 members had cerebellar ataxia, mental retardation, and dysequilibrium syndrome with quadrupedal locomotion and cerebellar atrophy.","pmid":"22892528","section":"clinical_features"},{"id":"gene:ATP8A2","type":"Gene","label":"ATP8A2"},{"id":"hpo:HP:0001251","type":"Phenotype","label":"Ataxia","hpo_id":"HP:0001251"},{"id":"phenotext:dysequilibrium","type":"PhenotypeText","label":"dysequilibrium"},{"id":"hpo:HP:0001272","type":"Phenotype","label":"Cerebellar atrophy","hpo_id":"HP:0001272"},{"id":"finding:22892528:2","type":"Finding","label":"Onat et al. (2013) used homozygosity mapping in the consanguineous Turkish family and found several homozygous regions shared by affected members, including one on chromosome 13q12.","pmid":"22892528","section":"mapping"},{"id":"finding:22892528:3","type":"Finding","label":"In the affected members of a consanguineous Turkish family with CAMRQ, Onat et al. (2013) identified a novel missense variant in the ATP8A2 gene, p.I376M. They found it by targeted next-generation sequencing of one affected individual, followed by segregation analysis, population screening, and prediction approaches. The variant lies in a highly conserved C-terminal transmembrane region of the E1 E2 ATPase domain.","pmid":"22892528","section":"molecular_genetics"},{"id":"variant:ATP8A2:p.I376M","type":"Variant","label":"ATP8A2 p.I376M","gene":"ATP8A2","keys":["p.I376M"],"omim_name":"ATP8A2, ILE376MET"},{"id":"finding:22892528:4","type":"Finding","label":"Onat et al. (2013) noted a previously identified unrelated individual with mental retardation and severe hypotonia who carried a de novo balanced t(10;13) translocation that disrupted the ATP8A2 gene.","pmid":"22892528","section":"cytogenetics"},{"id":"hpo:HP:0006829","type":"Phenotype","label":"Severe muscular hypotonia","hpo_id":"HP:0006829"},{"id":"finding:22892528:5","type":"Finding","label":"Onat et al. (2013) noted that ATP8A2 is expressed mainly in the brain and during development, particularly in the cerebellum. They suggested that ATP8A2 is involved in the development of the cerebro-cerebellar structures that humans need for posture and gait.","pmid":"22892528","section":"pathogenesis"},{"id":"finding:33079427:1","type":"Finding","label":"Mohamadian et al. (2020) described 3 sibs (a 9-year-old girl proband, a 15-year-old sister, and a 17-year-old brother) from a consanguineous Iranian family of Arab descent born to healthy first-cousin parents, with non-progressive cerebellar ataxia, severe hypotonia, intellectual disability, dysarthria, and cerebellar atrophy. The proband had severe neonatal hypotonia, global psychomotor delay, feeding difficulties since infancy, and was wheelchair-bound, unable to walk, sit, or hold her head. All 3 patients had IQ of 20 to 40, delayed speech with dysarthria, absent deep tendon reflexes, and cerebellar atrophy on brain MRI; hearing was normal, there were no seizures or optic atrophy, and metabolic investigations were normal.","pmid":"33079427","section":"clinical_features"},{"id":"hpo:HP:0002470","type":"Phenotype","label":"Nonprogressive cerebellar ataxia","hpo_id":"HP:0002470"},{"id":"hpo:HP:0001319","type":"Phenotype","label":"Neonatal hypotonia","hpo_id":"HP:0001319"},{"id":"hpo:HP:0010864","type":"Phenotype","label":"Severe intellectual disability","hpo_id":"HP:0010864"},{"id":"hpo:HP:0001263","type":"Phenotype","label":"Global developmental delay","hpo_id":"HP:0001263"},{"id":"hpo:HP:0002540","type":"Phenotype","label":"Inability to walk","hpo_id":"HP:0002540"},{"id":"hpo:HP:0011968","type":"Phenotype","label":"Feeding difficulties","hpo_id":"HP:0011968"},{"id":"hpo:HP:0000750","type":"Phenotype","label":"Delayed speech and language development","hpo_id":"HP:0000750"},{"id":"hpo:HP:0001284","type":"Phenotype","label":"Areflexia","hpo_id":"HP:0001284"},{"id":"hpo:HP:0000365","type":"Phenotype","label":"Hearing impairment","hpo_id":"HP:0000365"},{"id":"hpo:HP:0001250","type":"Phenotype","label":"Seizure","hpo_id":"HP:0001250"},{"id":"hpo:HP:0000648","type":"Phenotype","label":"Optic atrophy","hpo_id":"HP:0000648"},{"id":"finding:33079427:2","type":"Finding","label":"In 3 affected sibs from a consanguineous Iranian family with CAMRQ4, Mohamadian et al. (2020) identified a homozygous c.1339G-A transition (NM_016529.6) in exon 14 of the ATP8A2 gene, resulting in a gly447-to-arg (G447R) substitution at an extremely conserved residue in the ATP-binding (N) domain. The variant, found by whole-exome sequencing after normal karyotype and chromosomal microarray, was confirmed by Sanger sequencing and segregated with disease: parents and 2 unaffected sibs were heterozygous and 1 unaffected sib was wildtype. It was absent from public databases and 100 ethnically matched controls. Structural modeling predicted reduced protein stability and an altered ligand-binding pocket.","pmid":"33079427","section":"molecular_genetics"},{"id":"variant:ATP8A2:c.1339G>A","type":"Variant","label":"ATP8A2 c.1339G>A / c.np_057613.4: / p.G447R","gene":"ATP8A2","keys":["c.1339G>A","c.np_057613.4:","p.G447R"],"omim_name":"ATP8A2, GLY447ARG"},{"id":"finding:33079427:3","type":"Finding","label":"Mohamadian et al. (2020) predicted by homology modeling that the G447R substitution in ATP8A2 severely reduces protein stability (FoldX ddG 7.94 kcal/mol) and alters the ligand-binding pocket adjacent to the active site, which may decrease ligand-binding affinity and catalytic activity; they suggested it could also disrupt folding and interaction with CDC50A (TMEM30A).","pmid":"33079427","section":"pathogenesis"},{"id":"gene:CDC50A","type":"Gene","label":"CDC50A"},{"id":"finding:33682124:1","type":"Finding","label":"Damásio et al. (2021) described 2 sibs with congenital ataxia who learned to walk on their own by age 4 years. After 16 years of follow-up, they had near-normal cognition, cerebellar ataxia, mild pyramidal signs, and dystonia.","pmid":"33682124","section":"clinical_features"},{"id":"hpo:HP:0031936","type":"Phenotype","label":"Delayed ability to walk","hpo_id":"HP:0031936"},{"id":"hpo:HP:0007256","type":"Phenotype","label":"Abnormal pyramidal sign","hpo_id":"HP:0007256"},{"id":"hpo:HP:0001332","type":"Phenotype","label":"Dystonia","hpo_id":"HP:0001332"},{"id":"finding:33682124:2","type":"Finding","label":"In 2 sibs with congenital ataxia, Damásio et al. (2021) used exome sequencing to identify a novel homozygous variant in intron 17 of the ATP8A2 gene (c.1580-18C-G). Bioinformatics tools predicted that it creates a new acceptor splice site. In a minigene assay in HEK293T cells, the variant construct produced an aberrant transcript that kept 17 bp of intron 17 because an alternative acceptor splice site was used. This inserted 4 amino acids and created a premature stop codon. The authors concluded that the variant was disease-causing.","pmid":"33682124","section":"molecular_genetics"},{"id":"variant:ATP8A2:c.1580-18C>G","type":"Variant","label":"ATP8A2 c.1580-18C>G","gene":"ATP8A2","keys":["c.1580-18C>G"],"omim_name":"ATP8A2, 1580-18C-G"},{"id":"finding:33682124:3","type":"Finding","label":"Damásio et al. (2021) concluded that their findings expand ATP8A2-related disorders to include less severe forms of congenital ataxia.","pmid":"33682124","section":"genotype_phenotype_correlations"},{"id":"finding:35321980:1","type":"Finding","label":"Narishige et al. (2022) reported 2 Japanese siblings with CAMRQ4 who presented with athetotic movements at 1 and 2 months of age. They also had ptosis, ophthalmoplegia, feeding difficulty, hypotonia, and severely delayed development. One sib had retinal degeneration and optic atrophy. Flattening of auditory brainstem responses and areflexia developed later. At last follow-up, neither patient could sit or achieve head control, although some nonverbal communication was preserved.","pmid":"35321980","section":"clinical_features"},{"id":"hpo:HP:0002305","type":"Phenotype","label":"Athetosis","hpo_id":"HP:0002305"},{"id":"hpo:HP:0000508","type":"Phenotype","label":"Ptosis","hpo_id":"HP:0000508"},{"id":"hpo:HP:0000602","type":"Phenotype","label":"Ophthalmoplegia","hpo_id":"HP:0000602"},{"id":"hpo:HP:0001252","type":"Phenotype","label":"Hypotonia","hpo_id":"HP:0001252"},{"id":"hpo:HP:0011344","type":"Phenotype","label":"Severe global developmental delay","hpo_id":"HP:0011344"},{"id":"hpo:HP:0000546","type":"Phenotype","label":"Retinal degeneration","hpo_id":"HP:0000546"},{"id":"hpo:HP:0006958","type":"Phenotype","label":"Abnormal auditory evoked potentials","hpo_id":"HP:0006958"},{"id":"hpo:HP:0002421","type":"Phenotype","label":"Poor head control","hpo_id":"HP:0002421"},{"id":"finding:35321980:2","type":"Finding","label":"In 2 Japanese sibs with CAMRQ4, Narishige et al. (2022) identified compound heterozygous nonsense variants in the ATP8A2 gene by whole-exome sequencing: c.1741C>T (p.Arg581Ter), which had been previously reported, and c.2158C>T (p.Arg720Ter), which was novel.","pmid":"35321980","section":"molecular_genetics"},{"id":"variant:ATP8A2:c.1741C>T","type":"Variant","label":"ATP8A2 c.1741C>T / p.R581*","gene":"ATP8A2","keys":["c.1741C>T","p.R581*"],"omim_name":"ATP8A2, ARG581TER"},{"id":"variant:ATP8A2:c.2158C>T","type":"Variant","label":"ATP8A2 c.2158C>T / p.R720*","gene":"ATP8A2","keys":["c.2158C>T","p.R720*"],"omim_name":"ATP8A2, ARG720TER"},{"id":"finding:35321980:3","type":"Finding","label":"Narishige et al. (2022) noted that symptoms did not progress in early development, making CAMRQ4 difficult to distinguish from dyskinetic cerebral palsy, particularly in solitary cases, but suggested that visual and hearing impairments associated with involuntary movements and severe developmental delay may be a clue to suspect CAMRQ4.","pmid":"35321980","section":"diagnosis"}],"edges":[{"src":"paper:18326629","rel":"reports","dst":"finding:18326629:1"},{"src":"finding:18326629:1","rel":"in_section","dst":"section:heterogeneity"},{"src":"finding:18326629:1","rel":"mentions_gene","dst":"gene:VLDLR","pmid":"18326629"},{"src":"finding:18326629:1","rel":"has_phenotype","dst":"hpo:HP:0009878","pmid":"18326629","present":true,"text":"quadrupedal gait"},{"src":"finding:18326629:1","rel":"asserts_inheritance","dst":"inh:AR","pmid":"18326629"},{"src":"paper:18326629","rel":"reports","dst":"finding:18326629:2"},{"src":"finding:18326629:2","rel":"in_section","dst":"section:clinical_features"},{"src":"finding:18326629:2","rel":"has_phenotype","dst":"hpo:HP:0009878","pmid":"18326629","present":true,"text":"quadrupedal gait"},{"src":"finding:18326629:2","rel":"has_phenotype","dst":"hpo:HP:0001260","pmid":"18326629","present":true,"text":"dysarthric speech"},{"src":"finding:18326629:2","rel":"has_phenotype","dst":"hpo:HP:0001249","pmid":"18326629","present":true,"text":"mental retardation"},{"src":"finding:18326629:2","rel":"has_phenotype","dst":"hpo:HP:0001321","pmid":"18326629","present":true,"text":"cerebellar hypoplasia"},{"src":"finding:18326629:2","rel":"has_phenotype","dst":"hpo:HP:0002060","pmid":"18326629","present":true,"text":"cerebral hypoplasia"},{"src":"paper:18544652","rel":"reports","dst":"finding:18544652:1"},{"src":"finding:18544652:1","rel":"in_section","dst":"section:heterogeneity"},{"src":"finding:18544652:1","rel":"has_phenotype","dst":"hpo:HP:0001321","pmid":"18544652","present":true,"text":"cerebellar hypoplasia"},{"src":"finding:18544652:1","rel":"has_phenotype","dst":"hpo:HP:0009878","pmid":"18544652","present":true,"text":"quadrupedal locomotion"},{"src":"paper:21885617","rel":"reports","dst":"finding:21885617:1"},{"src":"finding:21885617:1","rel":"in_section","dst":"section:clinical_features"},{"src":"finding:21885617:1","rel":"has_phenotype","dst":"hpo:HP:0009878","pmid":"21885617","present":true,"text":"quadrupedal locomotion"},{"src":"finding:21885617:1","rel":"has_phenotype","dst":"hpo:HP:0001249","pmid":"21885617","present":true,"text":"mental retardation"},{"src":"finding:21885617:1","rel":"has_phenotype","dst":"hpo:HP:0001321","pmid":"21885617","present":true,"text":"cerebellar hypoplasia"},{"src":"finding:21885617:1","rel":"has_phenotype","dst":"hpo:HP:0002060","pmid":"21885617","present":true,"text":"cerebral hypoplasia"},{"src":"finding:21885617:1","rel":"has_phenotype","dst":"hpo:HP:0011931","pmid":"21885617","present":true,"text":"atrophy of cerebellar peduncles"},{"src":"finding:21885617:1","rel":"has_phenotype","dst":"hpo:HP:0001273","pmid":"21885617","present":true,"text":"corpus callosum abnormalities"},{"src":"finding:21885617:1","rel":"has_phenotype","dst":"hpo:HP:0002538","pmid":"21885617","present":true,"text":"precentral gyrus morphometric abnormalities"},{"src":"finding:21885617:1","rel":"asserts_inheritance","dst":"inh:AR","pmid":"21885617"},{"src":"paper:21885617","rel":"reports","dst":"finding:21885617:2"},{"src":"finding:21885617:2","rel":"in_section","dst":"section:mapping"},{"src":"finding:21885617:2","rel":"asserts_inheritance","dst":"inh:AR","pmid":"21885617"},{"src":"paper:21885617","rel":"reports","dst":"finding:21885617:3"},{"src":"finding:21885617:3","rel":"in_section","dst":"section:molec