{"seed":{"mim":"603552","entry_type":"phenotype","prefix":"#","title":"HEMOPHAGOCYTIC LYMPHOHISTIOCYTOSIS, FAMILIAL, 4","alt_titles":["HPLH4","HLH4"],"symbol":"FHL4","gene_symbols":[],"seed_pmids":[],"max_year":2020},"nodes":[{"id":"entry","type":"Entry","label":"HEMOPHAGOCYTIC LYMPHOHISTIOCYTOSIS, FAMILIAL, 4","mim":"603552","entry_type":"phenotype"},{"id":"section:description","type":"Section","label":"description"},{"id":"section:nomenclature","type":"Section","label":"nomenclature"},{"id":"section:cloning_expression","type":"Section","label":"cloning_expression"},{"id":"section:gene_structure","type":"Section","label":"gene_structure"},{"id":"section:clinical_features","type":"Section","label":"clinical_features"},{"id":"section:other_features","type":"Section","label":"other_features"},{"id":"section:biochemical_features","type":"Section","label":"biochemical_features"},{"id":"section:inheritance","type":"Section","label":"inheritance"},{"id":"section:cytogenetics","type":"Section","label":"cytogenetics"},{"id":"section:mapping","type":"Section","label":"mapping"},{"id":"section:heterogeneity","type":"Section","label":"heterogeneity"},{"id":"section:gene_function","type":"Section","label":"gene_function"},{"id":"section:molecular_genetics","type":"Section","label":"molecular_genetics"},{"id":"section:genotype_phenotype_correlations","type":"Section","label":"genotype_phenotype_correlations"},{"id":"section:pathogenesis","type":"Section","label":"pathogenesis"},{"id":"section:diagnosis","type":"Section","label":"diagnosis"},{"id":"section:clinical_management","type":"Section","label":"clinical_management"},{"id":"section:population_genetics","type":"Section","label":"population_genetics"},{"id":"section:evolution","type":"Section","label":"evolution"},{"id":"section:animal_model","type":"Section","label":"animal_model"},{"id":"section:history","type":"Section","label":"history"},{"id":"paper:32374962","type":"Paper","label":"Locatelli et al. (2020)","pmid":"32374962","year":2020,"content_level":"abstract","relevance":"supporting","title":"Emapalumab in Children with Primary Hemophagocytic Lymphohistiocytosis."},{"id":"paper:24459464","type":"Paper","label":"Müller et al. (2014)","pmid":"24459464","year":2014,"content_level":"fulltext","relevance":"primary","title":"An N-Terminal Missense Mutation in STX11 Causative of FHL4 Abrogates Syntaxin-11 Binding to Munc18-2."},{"id":"paper:16582076","type":"Paper","label":"Rudd et al. (2006)","pmid":"16582076","year":2006,"content_level":"abstract","relevance":"primary","title":"Spectrum and clinical implications of syntaxin 11 gene mutations in familial haemophagocytic lymphohistiocytosis: association with disease-free remissions and haematopoietic malignancies."},{"id":"paper:16278825","type":"Paper","label":"Zur Stadt et al. (2006)","pmid":"16278825","year":2006,"content_level":"abstract","relevance":"supporting","title":"Mutation spectrum in children with primary hemophagocytic lymphohistiocytosis: molecular and functional analyses of PRF1, UNC13D, STX11, and RAB27A."},{"id":"paper:15703195","type":"Paper","label":"zur Stadt et al. (2005)","pmid":"15703195","year":2005,"content_level":"abstract","relevance":"primary","title":"Linkage of familial hemophagocytic lymphohistiocytosis (FHL) type-4 to chromosome 6q24 and identification of mutations in syntaxin 11."},{"id":"finding:15703195:1","type":"Finding","label":"zur Stadt et al. (2005) performed genome-wide homozygosity mapping in a large consanguineous Kurdish kindred with 5 children affected with FHL. They found linkage to a 10-cM region on chromosome 6q24 between D6S1569 and D6S960, which defined a new FHL locus.","pmid":"15703195","section":"mapping"},{"id":"hpo:HP:0012156","type":"Phenotype","label":"Hemophagocytosis","hpo_id":"HP:0012156"},{"id":"inh:AR","type":"Inheritance","label":"Autosomal recessive","hpo_id":"HP:0000007"},{"id":"finding:15703195:2","type":"Finding","label":"In the consanguineous Kurdish kindred with FHL linked to 6q24, zur Stadt et al. (2005) screened positional candidate genes and identified a homozygous 5-bp deletion in the STX11 gene. Syntaxin-11 protein was absent from the mononuclear cell fraction of patients who were homozygous for the deletion. The same homozygous 5-bp deletion was also found in 2 additional consanguineous Turkish/Kurdish FHL kindreds.","pmid":"15703195","section":"molecular_genetics"},{"id":"gene:STX11","type":"Gene","label":"STX11"},{"id":"variant:STX11:raw:homozygous deletion of 5 bp","type":"Variant","label":"STX11 homozygous deletion of 5 bp","gene":"STX11","keys":["raw:homozygous deletion of 5 bp"],"omim_name":"STX11"},{"id":"finding:15703195:3","type":"Finding","label":"zur Stadt et al. (2005) identified a homozygous 19.2-kb genomic deletion spanning the entire coding region of STX11 (exon 2) in 1 consanguineous Turkish/Kurdish FHL kindred.","pmid":"15703195","section":"molecular_genetics"},{"id":"variant:STX11:raw:19.2 kb genomic deletion spanning the entire coding region of stx11 (exon 2)","type":"Variant","label":"STX11 19.2 kb genomic deletion spanning the entire coding region of STX11 (exon 2)","gene":"STX11","keys":["raw:19.2 kb genomic deletion spanning the entire coding region of stx11 (exon 2)"],"omim_name":"STX11"},{"id":"finding:15703195:4","type":"Finding","label":"In 2 consanguineous Turkish/Kurdish FHL kindreds, zur Stadt et al. (2005) identified a homozygous nonsense mutation in STX11 that leads to a premature stop codon in the C-terminal end of the protein.","pmid":"15703195","section":"molecular_genetics"},{"id":"variant:STX11:raw:nonsense mutation that leads to a premature stop codon in the c-terminal end of the protein","type":"Variant","label":"STX11 nonsense mutation that leads to a premature stop codon in the C-terminal end of the protein","gene":"STX11","keys":["raw:nonsense mutation that leads to a premature stop codon in the c-terminal end of the protein"],"omim_name":"STX11"},{"id":"finding:15703195:5","type":"Finding","label":"Because both STX11 and UNC13D are involved in vesicle trafficking and membrane fusion, zur Stadt et al. (2005) concluded that defects in the endocytotic or exocytotic pathway, in addition to perforin mutations, may be a common mechanism in FHL.","pmid":"15703195","section":"pathogenesis"},{"id":"gene:UNC13D","type":"Gene","label":"UNC13D"},{"id":"gene:PRF1","type":"Gene","label":"PRF1"},{"id":"finding:15703195:6","type":"Finding","label":"zur Stadt et al. (2005) noted that FHL is genetically heterogeneous: mutations in PRF1 and UNC13D underlie FHL2 and FHL3, respectively, and the 6q24 locus with STX11 mutations defined a new FHL locus.","pmid":"15703195","section":"heterogeneity"},{"id":"finding:16278825:1","type":"Finding","label":"Zur Stadt et al. (2006) screened 63 unrelated patients with FHL from Turkey (32), Germany (23) and other origins (8) for mutations in STX11, PRF1 and UNC13D. They found mutations in 38 patients: 20 in PRF1, 12 in UNC13D and 6 in STX11. All 6 patients with STX11 mutations were from Turkey; none of the German patients or patients of other origins had STX11 mutations.","pmid":"16278825","section":"molecular_genetics"},{"id":"finding:16278825:2","type":"Finding","label":"Zur Stadt et al. (2006) reported that FHL2, FHL3 and FHL4 together accounted for 80% of HLH cases of Turkish origin and 30% of German cases. STX11 mutations (FHL4) were found only in Turkish patients (6 of 32).","pmid":"16278825","section":"population_genetics"},{"id":"finding:16278825:3","type":"Finding","label":"Zur Stadt et al. (2006) concluded that FHL shows extensive genetic and allelic heterogeneity. Mutations were found in PRF1, UNC13D and STX11, and RAB27A mutations were found in 3 patients with FHL-related Griscelli syndrome type 2.","pmid":"16278825","section":"heterogeneity"},{"id":"gene:RAB27A","type":"Gene","label":"RAB27A"},{"id":"finding:16582076:1","type":"Finding","label":"Rudd et al. (2006) performed direct sequencing of STX11 in 28 FHL families without PRF1 mutations and identified 2 different previously reported STX11 mutations, a nonsense mutation and a deletion, in 6 of 34 children from 4 of the 28 unrelated families. STX11 mutations accounted for 14% of the PRF1-negative FHL families in the cohort.","pmid":"16582076","section":"molecular_genetics"},{"id":"variant:STX11:raw:nonsense mutation","type":"Variant","label":"STX11 nonsense mutation","gene":"STX11","keys":["raw:nonsense mutation"],"omim_name":"STX11"},{"id":"variant:STX11:raw:deletion","type":"Variant","label":"STX11 deletion","gene":"STX11","keys":["raw:deletion"],"omim_name":"STX11"},{"id":"finding:16582076:2","type":"Finding","label":"Rudd et al. (2006) found that 3 of 6 patients with STX11 mutations experienced long periods (1 year or more) of remission without specific treatment, which is very uncommon in FHL. Despite this milder phenotype, some children with STX11 mutations developed severe psychomotor retardation.","pmid":"16582076","section":"clinical_features"},{"id":"phenotext:prolonged disease-free remission without specific treatment","type":"PhenotypeText","label":"prolonged disease-free remission without specific treatment"},{"id":"hpo:HP:0001263","type":"Phenotype","label":"Global developmental delay","hpo_id":"HP:0001263"},{"id":"finding:16582076:3","type":"Finding","label":"Rudd et al. (2006) reported that 2 of 6 patients with STX11 mutations developed myelodysplastic syndrome or acute myelogenous leukemia, and suggested that STX11 mutations may be associated with secondary hematopoietic malignancies.","pmid":"16582076","section":"clinical_features"},{"id":"hpo:HP:0002863","type":"Phenotype","label":"Myelodysplasia","hpo_id":"HP:0002863"},{"id":"hpo:HP:0004808","type":"Phenotype","label":"Acute myeloid leukemia","hpo_id":"HP:0004808"},{"id":"finding:16582076:4","type":"Finding","label":"Rudd et al. (2006) concluded that there is segregation of specific clinical features, including disease-free remissions and haematopoietic malignancies, in FHL patients according to underlying genotype, with STX11 mutation carriers showing a milder phenotype.","pmid":"16582076","section":"genotype_phenotype_correlations"},{"id":"finding:24459464:1","type":"Finding","label":"Müller et al. (2014) described 3 children (2 males, 1 female) from unrelated consanguineous Pakistani families who presented with HLH at ages 2 months, 5 years, and 48 months. Patients A and B had fever, splenomegaly, hepatomegaly, anemia, neutropenia, thrombocytopenia, hypertriglyceridemia, hypofibrinogenemia, and hyperferritinemia, without hemophagocytosis or neurologic manifestations. They were treated with dexamethasone, cyclosporine A, and etoposide and were in remission at 2 months, but both died; patient A had undergone HSCT at 15 months. Patient C was lost to follow-up.","pmid":"24459464","section":"clinical_features"},{"id":"phenotext:hemophagocytic lymphohistiocytosis","type":"PhenotypeText","label":"hemophagocytic lymphohistiocytosis"},{"id":"hpo:HP:0001945","type":"Phenotype","label":"Fever","hpo_id":"HP:0001945"},{"id":"hpo:HP:0001744","type":"Phenotype","label":"Splenomegaly","hpo_id":"HP:0001744"},{"id":"hpo:HP:0002240","type":"Phenotype","label":"Hepatomegaly","hpo_id":"HP:0002240"},{"id":"hpo:HP:0001903","type":"Phenotype","label":"Anemia","hpo_id":"HP:0001903"},{"id":"hpo:HP:0001875","type":"Phenotype","label":"Decreased total neutrophil count","hpo_id":"HP:0001875"},{"id":"hpo:HP:0001873","type":"Phenotype","label":"Thrombocytopenia","hpo_id":"HP:0001873"},{"id":"hpo:HP:0002155","type":"Phenotype","label":"Hypertriglyceridemia","hpo_id":"HP:0002155"},{"id":"hpo:HP:0011900","type":"Phenotype","label":"Hypofibrinogenemia","hpo_id":"HP:0011900"},{"id":"hpo:HP:0003281","type":"Phenotype","label":"Increased circulating ferritin concentration","hpo_id":"HP:0003281"},{"id":"hpo:HP:0000707","type":"Phenotype","label":"Abnormality of the nervous system","hpo_id":"HP:0000707"},{"id":"finding:24459464:2","type":"Finding","label":"Müller et al. (2014) found that all 3 patients had defective NK cell lysis of K562 target cells and defective NK cell degranulation, which were partially restored by IL-2 stimulation; expression of perforin, granzyme B, and CD107a was normal, suggesting intact granule integrity.","pmid":"24459464","section":"clinical_features"},{"id":"hpo:HP:0012177","type":"Phenotype","label":"Abnormal natural killer cell physiology","hpo_id":"HP:0012177"},{"id":"hpo:HP:0025807","type":"Phenotype","label":"Decreased natural killer cell degranulation","hpo_id":"HP:0025807"},{"id":"finding:24459464:3","type":"Finding","label":"In 3 patients from unrelated consanguineous Pakistani families with FHL4, Müller et al. (2014) identified a novel homozygous c.173T-C transition in the STX11 gene, resulting in a leu58-to-pro (L58P) substitution in an alpha-helix of the predicted Habc domain, by sequencing of UNC13D, STX11, and STXBP2. Parents were heterozygous and had no history of inflammatory disease.","pmid":"24459464","section":"molecular_genetics"},{"id":"variant:STX11:c.173T>C","type":"Variant","label":"STX11 c.173T>C / p.L58P","gene":"STX11","keys":["c.173T>C","p.L58P"],"omim_name":"STX11, LEU58PRO"},{"id":"finding:24459464:4","type":"Finding","label":"Müller et al. (2014) noted that patient A, who also carried a heterozygous UNC13D P271S variant and a homozygous UNC13D R928C variant, presented earlier and showed less restoration of NK cell degranulation after IL-2 stimulation; they suggested the UNC13D variants might contribute to disease severity.","pmid":"24459464","section":"genotype_phenotype_correlations"},{"id":"variant:UNC13D:c.811C>T","type":"Variant","label":"UNC13D c.811C>T / p.P271S","gene":"UNC13D","keys":["c.811C>T","p.P271S"],"omim_name":"UNC13D, PRO271SER"},{"id":"variant:UNC13D:c.2782C>T","type":"Variant","label":"UNC13D c.2782C>T / p.R928C","gene":"UNC13D","keys":["c.2782C>T","p.R928C"],"omim_name":"UNC13D, ARG928CYS"},{"id":"finding:24459464:5","type":"Finding","label":"Müller et al. (2014) found greatly reduced syntaxin-11 expression in PBMCs and LAK cells from patient C, with normal Munc18-2 levels. In transfected HEK293T cells, L58P and an N-peptide R4A mutant were expressed at wildtype levels but failed to bind Munc18-2, whereas the FHL4-associated Q268X mutant bound normally. The authors concluded that both the N-terminus and Habc domain of syntaxin-11 are required for Munc18-2 binding and suggested that loss of this interaction destabilizes syntaxin-11 in patient cells.","pmid":"24459464","section":"pathogenesis"},{"id":"gene:STXBP2","type":"Gene","label":"STXBP2"},{"id":"finding:32374962:1","type":"Finding","label":"Locatelli et al. (2020) reported an open-label, single-group, phase 2-3 study of emapalumab, a human anti-interferon-gamma antibody, given with dexamethasone to patients aged 18 years or younger with primary hemophagocytic lymphohistiocytosis. Of 34 treated patients (27 previously treated and 7 previously untreated), 63% of previously treated patients and 65% of all patients who received emapalumab had a response, which was significantly higher than the prespecified null hypothesis of 40%. Seventy percent of previously treated patients went on to transplantation. Emapalumab was not associated with organ toxicity, but severe infections developed in 10 patients, and treatment was stopped in 1 patient because of disseminated histoplasmosis.","pmid":"32374962","section":"clinical_management"}],"edges":[{"src":"paper:15703195","rel":"reports","dst":"finding:15703195:1"},{"src":"finding:15703195:1","rel":"in_section","dst":"section:mapping"},{"src":"finding:15703195:1","rel":"has_phenotype","dst":"hpo:HP:0012156","pmid":"15703195","present":true,"text":"hemophagocytic lymphohistiocytosis"},{"src":"finding:15703195:1","rel":"asserts_inheritance","dst":"inh:AR","pmid":"15703195"},{"src":"paper:15703195","rel":"reports","dst":"finding:15703195:2"},{"src":"finding:15703195:2","rel":"in_section","dst":"section:molecular_genetics"},{"src":"finding:15703195:2","rel":"mentions_gene","dst":"gene:STX11","pmid":"15703195"},{"src":"finding:15703195:2","rel":"reports_variant","dst":"variant:STX11:raw:homozygous deletion of 5 bp","pmid":"15703195","zygosity":"homozygous","origin":"inherited","as_reported":"homozygous deletion of 5 bp"},{"src":"variant:STX11:raw:homozygous deletion of 5 bp","rel":"in_gene","dst":"gene:STX11"},{"src":"finding:15703195:2","rel":"asserts_inheritance","dst":"inh:AR","pmid":"15703195"},{"src":"paper:15703195","rel":"reports","dst":"finding:15703195:3"},{"src":"finding:15703195:3","rel":"in_section","dst":"section:molecular_genetics"},{"src":"finding:15703195:3","rel":"mentions_gene","dst":"gene:STX11","pmid":"15703195"},{"src":"finding:15703195:3","rel":"reports_variant","dst":"variant:STX11:raw:19.2 kb genomic deletion spanning the entire coding region of stx11 (exon 2)","pmid":"15703195","zygosity":"homozygous","origin":"inherited","as_reported":"19.2 kb genomic deletion spanning the entire coding region of STX11 (exon 2)"},{"src":"variant:STX11:raw:19.2 kb genomic deletion spanning the entire coding region of stx11 (exon 2)","rel":"in_gene","dst":"gene:STX11"},{"src":"finding:15703195:3","rel":"asserts_inheritance","dst":"inh:AR","pmid":"15703195"},{"src":"paper:15703195","rel":"reports","dst":"finding:15703195:4"},{"src":"finding:15703195:4","rel":"in_section","dst":"section:molecular_genetics"},{"src":"finding:15703195:4","rel":"mentions_gene","dst":"gene:STX11","pmid":"15703195"},{"src":"finding:15703195:4","rel":"reports_variant","dst":"variant:STX11:raw:nonsense mutation that leads to a premature stop codon in the c-terminal end of the protein","pmid":"15703195","zygosity":"homozygous","origin":"inherited","as_reported":"nonsense mutation that leads to a premature stop codon in the C-terminal end of the protein"},{"src":"variant:STX11:raw:nonsense mutation that leads to a premature stop codon in the c-terminal end of the protein","rel":"in_g