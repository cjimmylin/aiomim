,"Paper":9,"Finding":18,"Phenotype":18,"Inheritance":1,"Gene":1},"edges":{"reports":18,"in_section":18,"has_phenotype":40,"asserts_inheritance":12,"mentions_gene":3,"inheritance":1,"is_a":11}}}