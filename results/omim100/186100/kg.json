{"seed":{"mim":"186100","entry_type":"phenotype","prefix":"#","title":"SYNDACTYLY, TYPE III","alt_titles":["SYNDACTYLY OF FINGERS IV AND V","RING AND LITTLE FINGER SYNDACTYLY"],"symbol":"SDTY3","gene_symbols":[],"seed_pmids":[],"max_year":2004},"nodes":[{"id":"entry","type":"Entry","label":"SYNDACTYLY, TYPE III","mim":"186100","entry_type":"phenotype"},{"id":"section:description","type":"Section","label":"description"},{"id":"section:nomenclature","type":"Section","label":"nomenclature"},{"id":"section:cloning_expression","type":"Section","label":"cloning_expression"},{"id":"section:gene_structure","type":"Section","label":"gene_structure"},{"id":"section:clinical_features","type":"Section","label":"clinical_features"},{"id":"section:other_features","type":"Section","label":"other_features"},{"id":"section:biochemical_features","type":"Section","label":"biochemical_features"},{"id":"section:inheritance","type":"Section","label":"inheritance"},{"id":"section:cytogenetics","type":"Section","label":"cytogenetics"},{"id":"section:mapping","type":"Section","label":"mapping"},{"id":"section:heterogeneity","type":"Section","label":"heterogeneity"},{"id":"section:gene_function","type":"Section","label":"gene_function"},{"id":"section:molecular_genetics","type":"Section","label":"molecular_genetics"},{"id":"section:genotype_phenotype_correlations","type":"Section","label":"genotype_phenotype_correlations"},{"id":"section:pathogenesis","type":"Section","label":"pathogenesis"},{"id":"section:diagnosis","type":"Section","label":"diagnosis"},{"id":"section:clinical_management","type":"Section","label":"clinical_management"},{"id":"section:population_genetics","type":"Section","label":"population_genetics"},{"id":"section:evolution","type":"Section","label":"evolution"},{"id":"section:animal_model","type":"Section","label":"animal_model"},{"id":"section:history","type":"Section","label":"history"},{"id":"paper:14729836","type":"Paper","label":"Richardson et al. (2004)","pmid":"14729836","year":2004,"content_level":"title","relevance":"supporting","title":"Expression of Gja1 correlates with the phenotype observed in oculodentodigital syndrome/type III syndactyly."},{"id":"paper:14361398","type":"Paper","label":"JOHNSTON and KIRBY (1955)","pmid":"14361398","year":1955,"content_level":"title","relevance":"primary","title":"Syndactyly of the ring and little finger."},{"id":"paper:12457340","type":"Paper","label":"Paznekas et al. (2003)","pmid":"12457340","year":2003,"content_level":"abstract","relevance":"supporting","title":"Connexin 43 (GJA1) mutations cause the pleiotropic phenotype of oculodentodigital dysplasia."},{"id":"paper:9002680","type":"Paper","label":"Gladwin et al. (1997)","pmid":"9002680","year":1997,"content_level":"abstract","relevance":"supporting","title":"Localization of a gene for oculodentodigital syndrome to human chromosome 6q22-q24."},{"id":"paper:8313625","type":"Paper","label":"McKiernan and McCann (1993)","pmid":"8313625","year":1993,"content_level":"abstract","relevance":"primary","title":"Familial syndactyly type III--report of a large pedigree."},{"id":"paper:8110413","type":"Paper","label":"Schrander-Stumpel et al. (1993)","pmid":"8110413","year":1993,"content_level":"abstract","relevance":"primary","title":"Type III syndactyly and oculodentodigital dysplasia: a clinical spectrum."},{"id":"paper:8031535","type":"Paper","label":"De Smet et al. (1994)","pmid":"8031535","year":1994,"content_level":"abstract","relevance":"primary","title":"Syndactyly of the ring and small finger."},{"id":"paper:6249060","type":"Paper","label":"Opjordsmoen and Nyberg-Hansen (1980)","pmid":"6249060","year":1980,"content_level":"abstract","relevance":"background","title":"Hereditary spastic paraplegia with neurogenic bladder disturbances and syndactylia."},{"id":"paper:2157843","type":"Paper","label":"Brueton et al. (1990)","pmid":"2157843","year":1990,"content_level":"abstract","relevance":"primary","title":"Oculodentodigital dysplasia and type III syndactyly: separate genetic entities or disease spectrum?"},{"id":"finding:14361398:1","type":"Finding","label":"JOHNSTON and KIRBY (1955) reported syndactyly of the ring and little fingers.","pmid":"14361398","section":"clinical_features"},{"id":"hpo:HP:0010705","type":"Phenotype","label":"4-5 finger cutaneous syndactyly","hpo_id":"HP:0010705"},{"id":"finding:6249060:1","type":"Finding","label":"Opjordsmoen and Nyberg-Hansen (1980) reported a family from northern Norway in which 9 of 22 members across 3 generations had spastic paraplegia together with neurogenic bladder disturbance and syndactyly. The main complaint was the bladder disturbance, an incomplete supranuclear bladder paresis (uninhibited neurogenic bladder), which appeared early in the disease. The authors suggested that the family probably represented an unusual form of hereditary spastic paraplegia.","pmid":"6249060","section":"clinical_features"},{"id":"hpo:HP:0001258","type":"Phenotype","label":"Spastic paraplegia","hpo_id":"HP:0001258"},{"id":"hpo:HP:0000011","type":"Phenotype","label":"Neurogenic bladder","hpo_id":"HP:0000011"},{"id":"hpo:HP:0001159","type":"Phenotype","label":"Syndactyly","hpo_id":"HP:0001159"},{"id":"inh:AD","type":"Inheritance","label":"Autosomal dominant","hpo_id":"HP:0000006"},{"id":"finding:6249060:2","type":"Finding","label":"Opjordsmoen and Nyberg-Hansen (1980) concluded that the disorder of spastic paraplegia, neurogenic bladder and syndactyly in this 3-generation Norwegian family was inherited in an autosomal dominant pattern.","pmid":"6249060","section":"inheritance"},{"id":"finding:2157843:1","type":"Finding","label":"Brueton et al. (1990) described a family with type III syndactyly and a facial appearance resembling the facial phenotype of oculodentodigital dysplasia. The family had none of the other characteristic findings of oculodentodigital dysplasia.","pmid":"2157843","section":"clinical_features"},{"id":"hpo:HP:0000271","type":"Phenotype","label":"Abnormality of the face","hpo_id":"HP:0000271"},{"id":"finding:2157843:2","type":"Finding","label":"Brueton et al. (1990) discussed how type III syndactyly relates to oculodentodigital dysplasia, asking whether they are separate genetic entities or part of one disease spectrum.","pmid":"2157843","section":"heterogeneity"},{"id":"finding:8110413:1","type":"Finding","label":"Schrander-Stumpel et al. (1993) described a newborn boy with complete cutaneous syndactyly of fingers 3 to 5 on the left hand and fingers 4 and 5 on the right hand. His mother and maternal grandmother had been born with the same hand malformation. The mother had a thin nose and small teeth. The grandmother's teeth had been very small, with enamel hypoplasia. Both women had normal eyes.","pmid":"8110413","section":"clinical_features"},{"id":"hpo:HP:0006101","type":"Phenotype","label":"Finger syndactyly","hpo_id":"HP:0006101"},{"id":"hpo:HP:6000505","type":"Phenotype","label":"3-5 finger cutaneous syndactyly","hpo_id":"HP:6000505"},{"id":"hpo:HP:0000460","type":"Phenotype","label":"Narrow nose","hpo_id":"HP:0000460"},{"id":"hpo:HP:0000691","type":"Phenotype","label":"Microdontia","hpo_id":"HP:0000691"},{"id":"hpo:HP:0006297","type":"Phenotype","label":"Enamel hypoplasia","hpo_id":"HP:0006297"},{"id":"hpo:HP:0000478","type":"Phenotype","label":"Abnormality of the eye","hpo_id":"HP:0000478"},{"id":"finding:8110413:2","type":"Finding","label":"Schrander-Stumpel et al. (1993) concluded that inheritance was autosomal dominant in a family in which syndactyly was passed down through 3 generations: maternal grandmother, mother and son.","pmid":"8110413","section":"inheritance"},{"id":"finding:8110413:3","type":"Finding","label":"Schrander-Stumpel et al. (1993) concluded that the family showed variable expression of oculodentodigital dysplasia. They proposed that type III syndactyly and oculodentodigital dysplasia form a clinical spectrum.","pmid":"8110413","section":"heterogeneity"},{"id":"finding:8313625:1","type":"Finding","label":"McKiernan and McCann (1993) reported a large family with 14 members who had familial syndactyly of the ring and little fingers (type III syndactyly). They found that the clinical features varied between affected members. Three affected members had surgery in the authors' unit, and the senior author had previously operated on a fourth elsewhere.","pmid":"8313625","section":"clinical_features"},{"id":"hpo:HP:0003828","type":"Phenotype","label":"Variable expressivity","hpo_id":"HP:0003828"},{"id":"finding:8313625:2","type":"Finding","label":"McKiernan and McCann (1993) analyzed the pedigree of a large family with 14 members affected by type III syndactyly. They concluded that the analysis confirmed autosomal dominant inheritance.","pmid":"8313625","section":"inheritance"},{"id":"finding:8031535:1","type":"Finding","label":"De Smet et al. (1994) described 5 new cases of isolated syndactyly of the ring and small fingers. Brachymesophalangia of the fifth finger was a frequent association, and the authors stated that surgery is required at a young age.","pmid":"8031535","section":"clinical_features"},{"id":"hpo:HP:0004220","type":"Phenotype","label":"Short middle phalanx of the 5th finger","hpo_id":"HP:0004220"},{"id":"finding:8031535:2","type":"Finding","label":"De Smet et al. (1994) concluded that autosomal dominant inheritance was obvious in their cases of isolated ring-small finger syndactyly.","pmid":"8031535","section":"inheritance"},{"id":"finding:8031535:3","type":"Finding","label":"De Smet et al. (1994) stated that surgery is required at a young age for syndactyly of the ring and small fingers.","pmid":"8031535","section":"clinical_management"},{"id":"finding:9002680:1","type":"Finding","label":"Gladwin et al. (1997) studied a large family with type III syndactyly and atypical facial features. Their analysis suggested that isolated type III syndactyly maps to the same region of chromosome 6q22-q24 as the oculodentodigital syndrome (ODD) locus.","pmid":"9002680","section":"mapping"},{"id":"hpo:HP:0001999","type":"Phenotype","label":"Abnormal facial shape","hpo_id":"HP:0001999"},{"id":"finding:9002680:2","type":"Finding","label":"Gladwin et al. (1997) noted that type III syndactyly occurs as part of oculodentodigital syndrome but has also been reported as an isolated entity. They found linkage of ODD to polymorphic markers on chromosome 6q (pairwise maximum lod score = 9.37 at theta = 0.001).","pmid":"9002680","section":"heterogeneity"},{"id":"finding:12457340:1","type":"Finding","label":"Paznekas et al. (2003) noted that oculodentodigital dysplasia is an autosomal dominant syndrome with craniofacial (ocular, nasal, and dental) and limb dysmorphisms, spastic paraplegia, and neurodegeneration. Syndactyly type III and conductive deafness can occur in some cases, and cardiac abnormalities are rarely seen.","pmid":"12457340","section":"clinical_features"},{"id":"gene:GJA1","type":"Gene","label":"GJA1"},{"id":"hpo:HP:0000405","type":"Phenotype","label":"Conductive hearing impairment","hpo_id":"HP:0000405"},{"id":"hpo:HP:0001627","type":"Phenotype","label":"Abnormal heart morphology","hpo_id":"HP:0001627"},{"id":"hpo:HP:0000164","type":"Phenotype","label":"Abnormality of the dentition","hpo_id":"HP:0000164"},{"id":"hpo:HP:0002180","type":"Phenotype","label":"Neurodegeneration","hpo_id":"HP:0002180"},{"id":"finding:12457340:2","type":"Finding","label":"Paznekas et al. (2003) found GJA1 (connexin 43) mutations in all 17 families with oculodentodigital dysplasia that they screened. They found 16 different missense mutations and 1 codon duplication. The authors suggested that the mutations may cause misassembly of channels or alter channel conduction properties.","pmid":"12457340","section":"molecular_genetics"},{"id":"finding:14729836:1","type":"Finding","label":"Richardson et al. (2004) reported that expression of Gja1 correlated with the phenotype seen in oculodentodigital syndrome/type III syndactyly.","pmid":"14729836","section":"pathogenesis"}],"edges":[{"src":"paper:14361398","rel":"reports","dst":"finding:14361398:1"},{"src":"finding:14361398:1","rel":"in_section","dst":"section:clinical_features"},{"src":"finding:14361398:1","rel":"has_phenotype","dst":"hpo:HP:0010705","pmid":"14361398","present":true,"text":"syndactyly of the ring and little finger"},{"src":"paper:6249060","rel":"reports","dst":"finding:6249060:1"},{"src":"finding:6249060:1","rel":"in_section","dst":"section:clinical_features"},{"src":"finding:6249060:1","rel":"has_phenotype","dst":"hpo:HP:0001258","pmid":"6249060","present":true,"frequency":"9/22","text":"spastic paraplegia"},{"src":"finding:6249060:1","rel":"has_phenotype","dst":"hpo:HP:0000011","pmid":"6249060","present":true,"frequency":"9/22","text":"neurogenic bladder (uninhibited, incomplete supranuclear bladder paresis)"},{"src":"finding:6249060:1","rel":"has_phenotype","dst":"hpo:HP:0001159","pmid":"6249060","present":true,"frequency":"9/22","text":"syndactyly"},{"src":"finding:6249060:1","rel":"asserts_inheritance","dst":"inh:AD","pmid":"6249060"},{"src":"paper:6249060","rel":"reports","dst":"finding:6249060:2"},{"src":"finding:6249060:2","rel":"in_section","dst":"section:inheritance"},{"src":"finding:6249060:2","rel":"asserts_inheritance","dst":"inh:AD","pmid":"6249060"},{"src":"paper:2157843","rel":"reports","dst":"finding:2157843:1"},{"src":"finding:2157843:1","rel":"in_section","dst":"section:clinical_features"},{"src":"finding:2157843:1","rel":"has_phenotype","dst":"hpo:HP:0010705","pmid":"2157843","present":true,"text":"type III syndactyly"},{"src":"finding:2157843:1","rel":"has_phenotype","dst":"hpo:HP:0000271","pmid":"2157843","present":true,"text":"facies resembling oculodentodigital dysplasia"},{"src":"paper:2157843","rel":"reports","dst":"finding:2157843:2"},{"src":"finding:2157843:2","rel":"in_section","dst":"section:heterogeneity"},{"src":"paper:8110413","rel":"reports","dst":"finding:8110413:1"},{"src":"finding:8110413