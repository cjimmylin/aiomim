{"seed":{"mim":"613848","entry_type":"phenotype","prefix":"#","title":"OSTEOGENESIS IMPERFECTA, TYPE X","alt_titles":["OI, TYPE X"],"symbol":"OI10","gene_symbols":[],"seed_pmids":[],"max_year":2015},"nodes":[{"id":"entry","type":"Entry","label":"OSTEOGENESIS IMPERFECTA, TYPE X","mim":"613848","entry_type":"phenotype"},{"id":"section:description","type":"Section","label":"description"},{"id":"section:nomenclature","type":"Section","label":"nomenclature"},{"id":"section:cloning_expression","type":"Section","label":"cloning_expression"},{"id":"section:gene_structure","type":"Section","label":"gene_structure"},{"id":"section:clinical_features","type":"Section","label":"clinical_features"},{"id":"section:other_features","type":"Section","label":"other_features"},{"id":"section:biochemical_features","type":"Section","label":"biochemical_features"},{"id":"section:inheritance","type":"Section","label":"inheritance"},{"id":"section:cytogenetics","type":"Section","label":"cytogenetics"},{"id":"section:mapping","type":"Section","label":"mapping"},{"id":"section:heterogeneity","type":"Section","label":"heterogeneity"},{"id":"section:gene_function","type":"Section","label":"gene_function"},{"id":"section:molecular_genetics","type":"Section","label":"molecular_genetics"},{"id":"section:genotype_phenotype_correlations","type":"Section","label":"genotype_phenotype_correlations"},{"id":"section:pathogenesis","type":"Section","label":"pathogenesis"},{"id":"section:diagnosis","type":"Section","label":"diagnosis"},{"id":"section:clinical_management","type":"Section","label":"clinical_management"},{"id":"section:population_genetics","type":"Section","label":"population_genetics"},{"id":"section:evolution","type":"Section","label":"evolution"},{"id":"section:animal_model","type":"Section","label":"animal_model"},{"id":"section:history","type":"Section","label":"history"},{"id":"paper:25510505","type":"Paper","label":"Duran et al. (2015)","pmid":"25510505","year":2015,"content_level":"abstract","relevance":"primary","title":"HSP47 and FKBP65 cooperate in the synthesis of type I procollagen."},{"id":"paper:20188343","type":"Paper","label":"Christiansen et al. (2010)","pmid":"20188343","year":2010,"content_level":"abstract","relevance":"primary","title":"Homozygosity for a missense mutation in SERPINH1, which encodes the collagen chaperone protein HSP47, results in severe recessive osteogenesis imperfecta."},{"id":"finding:20188343:1","type":"Finding","label":"In an individual with severe autosomal recessive osteogenesis imperfecta, Christiansen et al. (2010) identified a homozygous missense mutation (c.233T>C, p.Leu78Pro) in the SERPINH1 gene, which encodes the collagen chaperone-like protein HSP47.","pmid":"20188343","section":"molecular_genetics"},{"id":"gene:SERPINH1","type":"Gene","label":"SERPINH1"},{"id":"variant:SERPINH1:c.233T>C","type":"Variant","label":"SERPINH1 c.233T>C / p.L78P","gene":"SERPINH1","keys":["c.233T>C","p.L78P"],"omim_name":"SERPINH1, LEU78PRO"},{"id":"hpo:HP:0002757","type":"Phenotype","label":"Recurrent fractures","hpo_id":"HP:0002757"},{"id":"inh:AR","type":"Inheritance","label":"Autosomal recessive","hpo_id":"HP:0000007"},{"id":"finding:20188343:2","type":"Finding","label":"Christiansen et al. (2010) found that the L78P mutation caused the endoplasmic reticulum-resident HSP47 to be degraded via the proteasome. In fibroblasts from the affected individual, type I procollagen accumulated in the Golgi, and part of the secreted type I procollagen was protease sensitive. The authors suggested that HSP47 monitors the integrity of the type I procollagen triple helix at the ER/cis-Golgi boundary, and that without it procollagen moves from the ER to the Golgi faster and its helical structure is compromised.","pmid":"20188343","section":"pathogenesis"},{"id":"finding:20188343:3","type":"Finding","label":"Christiansen et al. (2010) found normal 3-hydroxylation of the prolyl residue at position 986 of the proalpha1(I) triple helical domain in the patient. They concluded that HSP47 acts downstream of the CRTAP/P3H1/CyPB complex involved in prolyl 3-hydroxylation.","pmid":"20188343","section":"biochemical_features"},{"id":"finding:25510505:1","type":"Finding","label":"Duran et al. (2015) identified a new osteogenesis imperfecta mutation in the SERPINH1 gene. The mutation destabilized HSP47 and caused it to be mislocalized, and it secondarily had similar effects on FKBP65.","pmid":"25510505","section":"molecular_genetics"},{"id":"gene:FKBP10","type":"Gene","label":"FKBP10"},{"id":"finding:25510505:2","type":"Finding","label":"Duran et al. (2015) found evidence that HSP47 and FKBP65 act cooperatively during posttranslational maturation of type I procollagen, and that the two proteins fail to interact properly in cells with mutant HSP47. They concluded that OI caused by HSP47 deficiency and OI caused by FKBP65 deficiency share a common cellular pathway.","pmid":"25510505","section":"pathogenesis"}],"edges":[{"src":"paper:20188343","rel":"reports","dst":"finding:20188343:1"},{"src":"finding:20188343:1","rel":"in_section","dst":"section:molecular_genetics"},{"src":"finding:20188343:1","rel":"mentions_gene","dst":"gene:SERPINH1","pmid":"20188343"},{"src":"finding:20188343:1","rel":"reports_variant","dst":"variant:SERPINH1:c.233T>C","pmid":"20188343","zygosity":"homozygous","origin":"unknown","as_reported":"c.233T>C, p.Leu78Pro"},{"src":"variant:SERPINH1:c.233T>C","rel":"in_gene","dst":"gene:SERPINH1"},{"src":"finding:20188343:1","rel":"has_phenotype","dst":"hpo:HP:0002757","pmid":"20188343","present":true,"text":"severe osteogenesis imperfecta"},{"src":"finding:20188343:1","rel":"asserts_inheritance","dst":"inh:AR","pmid":"20188343"},{"src":"paper:20188343","rel":"reports","dst":"finding:20188343:2"},{"src":"finding:20188343:2","rel":"in_section","dst":"section:pathogenesis"},{"src":"finding:20188343:2","rel":"mentions_gene","dst":"gene:SERPINH1","pmid":"20188343"},{"src":"finding:20188343:2","rel":"reports_variant","dst":"variant:SERPINH1:c.233T>C","pmid":"20188343","zygosity":"homozygous","origin":"unknown","as_reported":"p.Leu78Pro"},{"src":"finding:20188343:2","rel":"asserts_inheritance","dst":"inh:AR","pmid":"20188343"},{"src":"paper:20188343","rel":"reports","dst":"finding:20188343:3"},{"src":"finding:20188343:3","rel":"in_section","dst":"section:biochemical_features"},{"src":"finding:20188343:3","rel":"mentions_gene","dst":"gene:SERPINH1","pmid":"20188343"},{"src":"paper:25510505","rel":"reports","dst":"finding:25510505:1"},{"src":"finding:25510505:1","rel":"in_section","dst":"section:molecular_genetics"},{"src":"finding:25510505:1","rel":"mentions_gene","dst":"gene:SERPINH1","pmid":"25510505"},{"src":"finding:25510505:1","rel":"mentions_gene","dst":"gene:FKBP10","pmid":"25510505"},{"src":"finding:25510505:1","rel":"asserts_inheritance","dst":"inh:AR","pmid":"25510505"},{"src":"paper:25510505","rel":"reports","dst":"finding:25510505:2"},{"src":"finding:25510505:2","rel":"in_section","dst":"section:pathogenesis"},{"src":"finding:25510505:2","rel":"mentions_gene","dst":"gene:SERPINH1","pmid":"25510505"},{"src":"finding:25510505:2","rel":"mentions_gene","dst":"gene:FKBP10","pmid":"25510505"},{"src":"entry","rel":"caused_by","dst":"gene:SERPINH1","pmids":["20188343"],"n_variants":1},{"src":"entry","rel":"has_variant","dst":"variant:SERPINH1:c.233T>C","pmids":["20188343"]},{"src":"entry","rel":"inheritance","dst":"inh:AR","pmids":["20188343","25510505"]},{"src":"entry","rel":"has_phenotype","dst":"hpo:HP:0002757","pmids":["20188343"],"absent_in":[]}],"stats":{"nodes":{"Entry":1,"Section":21,"Paper":2,"Finding":5,"Gene":2,"Variant":1,"Phenotype":1,"Inheritance":1},"edges":{"reports":5,"in_section":5,"mentions_gene":7,"reports_variant":2,"in_gene":1,"has_phenotype":2,"asserts_inheritance":3,"caused_by":1,"has_variant":1,"inheritance":1}}}