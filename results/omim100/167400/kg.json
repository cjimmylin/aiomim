{"seed":{"mim":"167400","entry_type":"phenotype","prefix":"#","title":"PAROXYSMAL EXTREME PAIN DISORDER","alt_titles":["PAIN, SUBMANDIBULAR, OCULAR, AND RECTAL, WITH FLUSHING","RECTAL PAIN, FAMILIAL","PEPD"],"symbol":"PEXPD","gene_symbols":[],"seed_pmids":[],"max_year":2014},"nodes":[{"id":"entry","type":"Entry","label":"PAROXYSMAL EXTREME PAIN DISORDER","mim":"167400","entry_type":"phenotype"},{"id":"section:description","type":"Section","label":"description"},{"id":"section:nomenclature","type":"Section","label":"nomenclature"},{"id":"section:cloning_expression","type":"Section","label":"cloning_expression"},{"id":"section:gene_structure","type":"Section","label":"gene_structure"},{"id":"section:clinical_features","type":"Section","label":"clinical_features"},{"id":"section:other_features","type":"Section","label":"other_features"},{"id":"section:biochemical_features","type":"Section","label":"biochemical_features"},{"id":"section:inheritance","type":"Section","label":"inheritance"},{"id":"section:cytogenetics","type":"Section","label":"cytogenetics"},{"id":"section:mapping","type":"Section","label":"mapping"},{"id":"section:heterogeneity","type":"Section","label":"heterogeneity"},{"id":"section:gene_function","type":"Section","label":"gene_function"},{"id":"section:molecular_genetics","type":"Section","label":"molecular_genetics"},{"id":"section:genotype_phenotype_correlations","type":"Section","label":"genotype_phenotype_correlations"},{"id":"section:pathogenesis","type":"Section","label":"pathogenesis"},{"id":"section:diagnosis","type":"Section","label":"diagnosis"},{"id":"section:clinical_management","type":"Section","label":"clinical_management"},{"id":"section:population_genetics","type":"Section","label":"population_genetics"},{"id":"section:evolution","type":"Section","label":"evolution"},{"id":"section:animal_model","type":"Section","label":"animal_model"},{"id":"section:history","type":"Section","label":"history"},{"id":"paper:24817410","type":"Paper","label":"Meglič et al. (2014)","pmid":"24817410","year":2014,"content_level":"abstract","relevance":"primary","title":"Painful micturition in a small child: an unusual clinical picture of paroxysmal extreme pain disorder."},{"id":"paper:17679678","type":"Paper","label":"Fertleman et al. (2007)","pmid":"17679678","year":2007,"content_level":"abstract","relevance":"primary","title":"Paroxysmal extreme pain disorder (previously familial rectal pain syndrome)."},{"id":"paper:17145499","type":"Paper","label":"Fertleman et al. (2006)","pmid":"17145499","year":2006,"content_level":"abstract","relevance":"primary","title":"SCN9A mutations in paroxysmal extreme pain disorder: allelic variants underlie distinct channel defects and phenotypes."},{"id":"paper:17043302","type":"Paper","label":"Fertleman and Ferrie (2006)","pmid":"17043302","year":2006,"content_level":"title","relevance":"supporting","title":"What's in a name--familial rectal pain syndrome becomes paroxysmal extreme pain disorder."},{"id":"paper:13636703","type":"Paper","label":"HAYDEN and GROSSMAN (1959)","pmid":"13636703","year":1959,"content_level":"title","relevance":"primary","title":"Rectal, ocular, and submaxillary pain; a familial autonomic disorder related to proctalgia fugaz: report of a family."},{"id":"paper:4112340","type":"Paper","label":"Mann and Cree (1972)","pmid":"4112340","year":1972,"content_level":"title","relevance":"primary","title":"Familial rectal pain."},{"id":"paper:4111621","type":"Paper","label":"Dugan (1972)","pmid":"4111621","year":1972,"content_level":"title","relevance":"supporting","title":"Familial rectal pain."},{"id":"finding:13636703:1","type":"Finding","label":"HAYDEN and GROSSMAN (1959) reported a family with rectal, ocular, and submaxillary pain. They described it as a familial autonomic disorder related to proctalgia fugax.","pmid":"13636703","section":"clinical_features"},{"id":"hpo:HP:0500005","type":"Phenotype","label":"Anal pain","hpo_id":"HP:0500005"},{"id":"hpo:HP:0200026","type":"Phenotype","label":"Ocular pain","hpo_id":"HP:0200026"},{"id":"hpo:HP:0012531","type":"Phenotype","label":"Pain","hpo_id":"HP:0012531"},{"id":"finding:4111621:1","type":"Finding","label":"Dugan (1972) reported familial rectal pain.","pmid":"4111621","section":"clinical_features"},{"id":"finding:4112340:1","type":"Finding","label":"Mann and Cree (1972) reported familial rectal pain.","pmid":"4112340","section":"clinical_features"},{"id":"finding:17043302:1","type":"Finding","label":"Fertleman and Ferrie (2006) noted that the disorder formerly called familial rectal pain syndrome had been renamed paroxysmal extreme pain disorder.","pmid":"17043302","section":"nomenclature"},{"id":"finding:17145499:1","type":"Finding","label":"Fertleman et al. (2006) described paroxysmal extreme pain disorder (PEPD), formerly called familial rectal pain, as an inherited condition characterized by paroxysms of rectal, ocular, or submandibular pain with flushing.","pmid":"17145499","section":"description"},{"id":"hpo:HP:0032148","type":"Phenotype","label":"Episodic pain","hpo_id":"HP:0032148"},{"id":"hpo:HP:0031284","type":"Phenotype","label":"Flushing","hpo_id":"HP:0031284"},{"id":"finding:17145499:2","type":"Finding","label":"Fertleman et al. (2006) proposed the name paroxysmal extreme pain disorder (PEPD) for the condition previously known as familial rectal pain (FRP).","pmid":"17145499","section":"nomenclature"},{"id":"finding:17145499:3","type":"Finding","label":"Fertleman et al. (2006) carried out a genome-wide linkage search followed by mutation analysis of the candidate gene SCN9A, which encodes the sodium channel Nav1.7. They identified 8 missense mutations in 11 families with PEPD and in 2 sporadic cases.","pmid":"17145499","section":"molecular_genetics"},{"id":"gene:SCN9A","type":"Gene","label":"SCN9A"},{"id":"finding:17145499:4","type":"Finding","label":"Fertleman et al. (2006) tested 3 of the mutant Nav1.7 channels in vitro and found reduced fast inactivation, which led to a persistent sodium current. By contrast, SCN9A mutations that cause primary erythermalgia are associated with more negative activation thresholds. The authors concluded that PEPD and primary erythermalgia are allelic disorders with distinct biophysical mechanisms and represent a separate class of peripheral neuronal sodium channelopathy.","pmid":"17145499","section":"pathogenesis"},{"id":"finding:17145499:5","type":"Finding","label":"Fertleman et al. (2006) noted that carbamazepine is effective in PEPD but not in primary erythermalgia. In vitro, carbamazepine selectively blocked the persistent current of the PEPD mutant channels but did not affect the negative activation threshold of a primary erythermalgia mutant.","pmid":"17145499","section":"clinical_management"},{"id":"finding:17679678:1","type":"Finding","label":"Fertleman et al. (2007) described the clinical phenotype of 77 individuals from 15 families with paroxysmal extreme pain disorder. Clinical details were collected through an international consortium, and 14 affected individuals completed a validated pain questionnaire. Onset was in the neonatal period or infancy, and the disorder persisted throughout life. Early on, autonomic features predominated: all patients had skin flushing, and most had harlequin color change and tonic attacks. Dramatic syncopes with bradycardia, sometimes with asystole, were common.","pmid":"17679678","section":"clinical_features"},{"id":"hpo:HP:0001000","type":"Phenotype","label":"Abnormal skin pigmentation","hpo_id":"HP:0001000"},{"id":"hpo:HP:0032792","type":"Phenotype","label":"Tonic seizure","hpo_id":"HP:0032792"},{"id":"hpo:HP:0001279","type":"Phenotype","label":"Syncope","hpo_id":"HP:0001279"},{"id":"hpo:HP:0001662","type":"Phenotype","label":"Bradycardia","hpo_id":"HP:0001662"},{"id":"phenotext:asystole","type":"PhenotypeText","label":"asystole"},{"id":"inh:AD","type":"Inheritance","label":"Autosomal dominant","hpo_id":"HP:0000006"},{"id":"finding:17679678:2","type":"Finding","label":"Fertleman et al. (2007) reported that, later in life, the disorder was marked by attacks of excruciating deep burning pain. The pain was often in the rectal, ocular, or jaw areas but could also be diffuse. Attacks were triggered by defecation, cold wind, eating, and emotion.","pmid":"17679678","section":"clinical_features"},{"id":"hpo:HP:0040264","type":"Phenotype","label":"Jaw pain","hpo_id":"HP:0040264"},{"id":"finding:17679678:3","type":"Finding","label":"Fertleman et al. (2007) found that carbamazepine was effective in almost all patients who tried it, but the response was often incomplete.","pmid":"17679678","section":"clinical_management"},{"id":"finding:17679678:4","type":"Finding","label":"Fertleman et al. (2007) noted that paroxysmal extreme pain disorder is most likely to be misdiagnosed as epilepsy. In infancy in particular, it may be misdiagnosed as hyperekplexia or as reflex anoxic seizures.","pmid":"17679678","section":"diagnosis"},{"id":"finding:17679678:5","type":"Finding","label":"Fertleman et al. (2007) used the name paroxysmal extreme pain disorder for the condition previously called familial rectal pain syndrome. They described it as an autosomal dominant sodium channelopathy involving SCN9A.","pmid":"17679678","section":"nomenclature"},{"id":"finding:24817410:1","type":"Finding","label":"Meglič et al. (2014) described a 3-year-old girl with an unusual presentation of PEPD: extremely painful voiding (micturition) that had been present since birth. Her father had occasionally had some pain in his jaw while yawning since childhood.","pmid":"24817410","section":"clinical_features"},{"id":"hpo:HP:0100518","type":"Phenotype","label":"Dysuria","hpo_id":"HP:0100518"},{"id":"finding:24817410:2","type":"Finding","label":"In a 3-year-old girl with PEPD presenting with painful micturition, Meglič et al. (2014) identified a heterozygous c.554G>A (p.Arg185His) mutation in the SCN9A gene, inherited from her mildly affected father, who also carried the mutation. The authors noted that the same mutation had been found in patients with small fiber sensory neuropathy, and suggested that intra- and interfamilial phenotypic diversity associated with gain-of-function Nav1.7 variants may explain their case.","pmid":"24817410","section":"molecular_genetics"},{"id":"variant:SCN9A:c.554G>A","type":"Variant","label":"SCN9A c.554G>A / p.R185H","gene":"SCN9A","keys":["c.554G>A","p.R185H"],"omim_name":"SCN9A, ARG185HIS"},{"id":"finding:24817410:3","type":"Finding","label":"Meglič et al. (2014) reported that carbamazepine significantly reduced pain in a 3-year-old girl with PEPD and painful voiding.","pmid":"24817410","section":"clinical_management"}],"edges":[{"src":"paper:13636703","rel":"reports","dst":"finding:13636703:1"},{"src":"finding:13636703:1","rel":"in_section","dst":"section:clinical_features"},{"src":"finding:13636703:1","rel":"has_phenotype","dst":"hpo:HP:0500005","pmid":"13636703","present":true,"text":"rectal pain"},{"src":"finding:13636703:1","rel":"has_phenotype","dst":"hpo:HP:0200026","pmid":"13636703","present":true,"text":"ocular pain"},{"src":"finding:13636703:1","rel":"has_phenotype","dst":"hpo:HP:0012531","pmid":"13636703","present":true,"text":"submaxillary pain"},{"src":"paper:4111621","rel":"reports","dst":"finding:4111621:1"},{"src":"finding:4111621:1","rel":"in_section","dst":"section:clinical_features"},{"src":"finding:4111621:1","rel":"has_phenotype","dst":"hpo:HP:0500005","pmid":"4111621","present":true,"text":"rectal pain"},{"src":"paper:4112340","rel":"reports","dst":"finding:4112340:1"},{"src":"finding:4112340:1","rel":"in_section","dst":"section:clinical_features"},{"src":"finding:4112340:1","rel":"has_phenotype","dst":"hpo:HP:0500005","pmid":"4112340","present":true,"text":"rectal pain"},{"src":"paper:17043302","rel":"reports","dst":"finding:17043302:1"},{"src":"finding:17043302:1","rel":"in_section","dst":"section:nomenclature"},{"src":"paper:17145499","rel":"reports",