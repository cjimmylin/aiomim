"26392740"],"absent_in":[]},{"src":"entry","rel":"has_phenotype","dst":"hpo:HP:0007663","pmids":["19452014"],"absent_in":[]},{"src":"entry","rel":"has_phenotype","dst":"hpo:HP:0012109","pmids":["19452014"],"absent_in":[]},{"src":"entry","rel":"has_phenotype","dst":"hpo:HP:0000667","pmids":["19452014"],"absent_in":[]},{"src":"entry","rel":"has_phenotype","dst":"hpo:HP:0001328","pmids":["19452014"],"absent_in":[]},{"src":"entry","rel":"has_phenotype","dst":"hpo:HP:0000591","pmids":["19452014"],"absent_in":[]},{"src":"hpo:HP:0008499","rel":"is_a","dst":"hpo:HP:0000540"}],"stats":{"nodes":{"Entry":1,"Section":21,"Paper":4,"Finding":17,"Phenotype":8,"PhenotypeText":2,"Inheritance":1,"Gene":6,"Variant":3},"edges":{"reports":17,"in_section":17,"has_phenotype":28,"asserts_inheritance":15,"mentions_gene":12,"reports_variant":3,"in_gene":3,"caused_by":1,"has_variant":3,"inheritance":1,"is_a":1}}}