","rel":"mentions_gene","dst":"gene:NEFL","pmid":"19158810"},{"src":"finding:19158810:2","rel":"reports_variant","dst":"variant:NEFL:p.E140*","pmid":"19158810","zygosity":"homozygous","origin":"unknown","as_reported":"Glu140Stop"},{"src":"variant:NEFL:p.E140*","rel":"in_gene","dst":"gene:NEFL"},{"src":"finding:19158810:2","rel":"asserts_inheritance","dst":"inh:AR","pmid":"19158810"},{"src":"paper:19158810","rel":"reports","dst":"finding:19158810:3"},{"src":"finding:19158810:3","rel":"in_section","dst":"section:clinical_features"},{"src":"finding:19158810:3","rel":"mentions_gene","dst":"gene:NEFL","pmid":"19158810"},{"src":"finding:19158810:3","rel":"has_phenotype","dst":"hpo:HP:0003431","pmid":"19158810","present":true,"frequency":"6/6","text":"mildly to moderately delayed nerve conduction velocities"},{"src":"paper:19158810","rel":"reports","dst":"finding:19158810:4"},{"src":"finding:19158810:4","rel":"in_section","dst":"section:genotype_phenotype_correlations"},{"src":"finding:19158810:4","rel":"mentions_gene","dst":"gene:NEFL","pmid":"19158810"},{"src":"paper:20039262","rel":"reports","dst":"finding:20039262:1"},{"src":"finding:20039262:1","rel":"in_section","dst":"section:clinical_features"},{"src":"finding:20039262:1","rel":"mentions_gene","dst":"gene:NEFL","pmid":"20039262"},{"src":"finding:20039262:1","rel":"has_phenotype","dst":"hpo:HP:0008947","pmid":"20039262","present":true,"frequency":"4/4","text":"hypotonia in infancy"},{"src":"finding:20039262:1","rel":"has_phenotype","dst":"hpo:HP:0002194","pmid":"20039262","present":true,"frequency":"4/4","text":"delayed motor milestones"},{"src":"finding:20039262:1","rel":"has_phenotype","dst":"hpo:HP:0002460","pmid":"20039262","present":true,"frequency":"4/4","text":"distal muscle weakness and atrophy"},{"src":"finding:20039262:1","rel":"has_phenotype","dst":"hpo:HP:0001761","pmid":"20039262","present":true,"text":"pes cavus"},{"src":"finding:20039262:1","rel":"has_phenotype","dst":"hpo:HP:0002936","pmid":"20039262