,"rel":"has_phenotype","dst":"hpo:HP:0003438","pmids":["20039262"],"absent_in":[]},{"src":"entry","rel":"has_phenotype","dst":"hpo:HP:0002515","pmids":["20039262"],"absent_in":[]},{"src":"entry","rel":"has_phenotype","dst":"hpo:HP:0001328","pmids":["20039262"],"absent_in":[]},{"src":"entry","rel":"has_phenotype","dst":"hpo:HP:0003431","pmids":["12566280","19158810","20039262"],"absent_in":[]},{"src":"entry","rel":"has_phenotype","dst":"hpo:HP:0007078","pmids":["20039262"],"absent_in":[]},{"src":"entry","rel":"has_phenotype","dst":"hpo:HP:0033383","pmids":["20039262"],"absent_in":[]},{"src":"entry","rel":"has_phenotype","dst":"hpo:HP:0000649","pmids":["20039262"],"absent_in":[]},{"src":"entry","rel":"has_phenotype","dst":"hpo:HP:0003445","pmids":["20039262"],"absent_in":[]},{"src":"entry","rel":"has_phenotype","dst":"hpo:HP:0003380","pmids":["20039262"],"absent_in":[]},{"src":"entry","rel":"has_phenotype","dst":"hpo:HP:0045010","pmids":["20039262"],"absent_in":[]},{"src":"entry","rel":"has_phenotype","dst":"hpo:HP:0009830","pmids":["12566280"],"absent_in":[]},{"src":"entry","rel":"has_phenotype","dst":"hpo:HP:0003450","pmids":["12566280"],"absent_in":[]},{"src":"entry","rel":"has_phenotype","dst":"hpo:HP:0003383","pmids":["12566280"],"absent_in":[]}],"stats":{"nodes":{"Entry":1,"Section":21,"Paper":3,"Finding":14,"Gene":1,"Inheritance":2,"Phenotype":20,"Variant":7},"edges":{"reports":14,"in_section":14,"mentions_gene":14,"asserts_inheritance":10,"has_phenotype":40,"reports_variant":9,"in_gene":7,"caused_by":1,"has_variant":7,"inheritance":2}}}