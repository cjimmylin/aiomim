{"seed":{"mim":"108770","entry_type":"phenotype","prefix":"#","title":"ATRIAL STANDSTILL 1","alt_titles":[],"symbol":"ATRST1","gene_symbols":[],"seed_pmids":[],"max_year":2005},"nodes":[{"id":"entry","type":"Entry","label":"ATRIAL STANDSTILL 1","mim":"108770","entry_type":"phenotype"},{"id":"section:description","type":"Section","label":"description"},{"id":"section:nomenclature","type":"Section","label":"nomenclature"},{"id":"section:cloning_expression","type":"Section","label":"cloning_expression"},{"id":"section:gene_structure","type":"Section","label":"gene_structure"},{"id":"section:clinical_features","type":"Section","label":"clinical_features"},{"id":"section:other_features","type":"Section","label":"other_features"},{"id":"section:biochemical_features","type":"Section","label":"biochemical_features"},{"id":"section:inheritance","type":"Section","label":"inheritance"},{"id":"section:cytogenetics","type":"Section","label":"cytogenetics"},{"id":"section:mapping","type":"Section","label":"mapping"},{"id":"section:heterogeneity","type":"Section","label":"heterogeneity"},{"id":"section:gene_function","type":"Section","label":"gene_function"},{"id":"section:molecular_genetics","type":"Section","label":"molecular_genetics"},{"id":"section:genotype_phenotype_correlations","type":"Section","label":"genotype_phenotype_correlations"},{"id":"section:pathogenesis","type":"Section","label":"pathogenesis"},{"id":"section:diagnosis","type":"Section","label":"diagnosis"},{"id":"section:clinical_management","type":"Section","label":"clinical_management"},{"id":"section:population_genetics","type":"Section","label":"population_genetics"},{"id":"section:evolution","type":"Section","label":"evolution"},{"id":"section:animal_model","type":"Section","label":"animal_model"},{"id":"section:history","type":"Section","label":"history"},{"id":"paper:16188595","type":"Paper","label":"Makita et al. (2005)","pmid":"16188595","year":2005,"content_level":"abstract","relevance":"primary","title":"Congenital atrial standstill associated with coinheritance of a novel SCN5A mutation and connexin 40 polymorphisms."},{"id":"paper:16176547","type":"Paper","label":"Fazelifar et al. (2005)","pmid":"16176547","year":2005,"content_level":"abstract","relevance":"primary","title":"Familial atrial standstill in association with dilated cardiomyopathy."},{"id":"paper:12522116","type":"Paper","label":"Groenewegen et al. (2003)","pmid":"12522116","year":2003,"content_level":"abstract","relevance":"primary","title":"A cardiac sodium channel mutation cosegregates with a rare connexin40 genotype in familial atrial standstill."},{"id":"paper:5347950","type":"Paper","label":"Harrison and Derrick (1969)","pmid":"5347950","year":1969,"content_level":"title","relevance":"primary","title":"Atrial standstill: a review, and presentation of two new cases of familial and unususal nature with reference to epicardial pacing in one."},{"id":"paper:4981961","type":"Paper","label":"Allensworth et al. (1969)","pmid":"4981961","year":1969,"content_level":"title","relevance":"primary","title":"Persistent atrial standstill in a family with myocardial dease."},{"id":"paper:4636548","type":"Paper","label":"Williams et al. (1972)","pmid":"4636548","year":1972,"content_level":"title","relevance":"primary","title":"Familial atrial cardiomyopathy with heart block."},{"id":"paper:4430108","type":"Paper","label":"Amat-y-Leon et al. (1974)","pmid":"4430108","year":1974,"content_level":"title","relevance":"supporting","title":"Familial atrial dysrhythmia with A-V block. Intracellular microelectrode, clinical electrophysiologic, and morphologic observations."},{"id":"paper:1575158","type":"Paper","label":"Shah et al. (1992)","pmid":"1575158","year":1992,"content_level":"title","relevance":"primary","title":"Familial total atrial standstill."},{"id":"finding:4981961:1","type":"Finding","label":"Allensworth et al. (1969) reported persistent atrial standstill in a family with myocardial disease.","pmid":"4981961","section":"clinical_features"},{"id":"hpo:HP:0025478","type":"Phenotype","label":"Atrial standstill","hpo_id":"HP:0025478"},{"id":"hpo:HP:0001638","type":"Phenotype","label":"Cardiomyopathy","hpo_id":"HP:0001638"},{"id":"finding:5347950:1","type":"Finding","label":"Harrison and Derrick (1969) reviewed atrial standstill and described 2 new cases that they called familial and unusual. One of these patients was treated with epicardial pacing.","pmid":"5347950","section":"clinical_features"},{"id":"finding:4636548:1","type":"Finding","label":"Williams et al. (1972) reported a familial form of atrial cardiomyopathy with heart block.","pmid":"4636548","section":"clinical_features"},{"id":"hpo:HP:0012722","type":"Phenotype","label":"Heart block","hpo_id":"HP:0012722"},{"id":"finding:4430108:1","type":"Finding","label":"Amat-y-Leon et al. (1974) reported a familial atrial dysrhythmia with atrioventricular block. They studied it with intracellular microelectrode recordings, clinical electrophysiologic studies and morphologic observations.","pmid":"4430108","section":"clinical_features"},{"id":"hpo:HP:0001692","type":"Phenotype","label":"Atrial arrhythmia","hpo_id":"HP:0001692"},{"id":"hpo:HP:0001678","type":"Phenotype","label":"Atrioventricular block","hpo_id":"HP:0001678"},{"id":"finding:1575158:1","type":"Finding","label":"Shah et al. (1992) reported familial total atrial standstill.","pmid":"1575158","section":"clinical_features"},{"id":"finding:12522116:1","type":"Finding","label":"Groenewegen et al. (2003) clinically evaluated 44 members of a large family with atrial standstill. One deceased and three living relatives were unambiguously affected by atrial standstill; all other relatives appeared unaffected.","pmid":"12522116","section":"clinical_features"},{"id":"finding:12522116:2","type":"Finding","label":"In a large family with atrial standstill, Groenewegen et al. (2003) used candidate gene screening to identify a novel SCN5A mutation, D1275N, in all 3 affected living relatives and in 5 unaffected relatives; the deceased affected relative was an obligate carrier. SCN5A-D1275N channels showed a small depolarizing shift in activation compared with wildtype channels.","pmid":"12522116","section":"molecular_genetics"},{"id":"gene:SCN5A","type":"Gene","label":"SCN5A"},{"id":"variant:SCN5A:p.D1275N","type":"Variant","label":"SCN5A p.D1275N","gene":"SCN5A","keys":["p.D1275N"],"omim_name":"SCN5A, ASP1275ASN"},{"id":"finding:12522116:3","type":"Finding","label":"Groenewegen et al. (2003) also detected 2 closely linked polymorphisms in regulatory regions of the atrial-specific gap junction gene connexin-40 (Cx40; GJA5), at nucleotides -44 (G-A) and +71 (A-G). Eight relatives were homozygous for both polymorphisms, a genotype found in only about 7% of controls, and 3 of these were affected. Reporter gene analysis showed reduced expression with the rare Cx40 genotype compared with the more common genotype.","pmid":"12522116","section":"molecular_genetics"},{"id":"gene:GJA5","type":"Gene","label":"GJA5"},{"id":"variant:GJA5:raw:-44 (g-->a)","type":"Variant","label":"GJA5 -44 (G-->A)","gene":"GJA5","keys":["raw:-44 (g-->a)"],"omim_name":"GJA5"},{"id":"variant:GJA5:raw:+71 (a-->g)","type":"Variant","label":"GJA5 +71 (A-->G)","gene":"GJA5","keys":["raw:+71 (a-->g)"],"omim_name":"GJA5"},{"id":"finding:12522116:4","type":"Finding","label":"Groenewegen et al. (2003) found that the 3 living patients with atrial standstill were the only relatives who coinherited both the rare homozygous Cx40 genotype and the SCN5A D1275N mutation. They proposed that, although each genetic change alone had a relatively benign functional effect, the combined effect eventually progressed to total atrial standstill.","pmid":"12522116","section":"inheritance"},{"id":"inh:DIGENIC","type":"Inheritance","label":"Digenic","hpo_id":"HP:0010984"},{"id":"finding:16176547:1","type":"Finding","label":"Fazelifar et al. (2005) reported a family with atrial standstill associated with syncope, dilated cardiomyopathy, and sudden cardiac death.","pmid":"16176547","section":"clinical_features"},{"id":"hpo:HP:0001279","type":"Phenotype","label":"Syncope","hpo_id":"HP:0001279"},{"id":"hpo:HP:0001644","type":"Phenotype","label":"Dilated cardiomyopathy","hpo_id":"HP:0001644"},{"id":"hpo:HP:0001645","type":"Phenotype","label":"Sudden cardiac death","hpo_id":"HP:0001645"},{"id":"finding:16176547:2","type":"Finding","label":"Fazelifar et al. (2005) noted that atrial standstill is an extremely uncommon arrhythmia that rarely appears to be familial, and that it has been associated with conditions including congenital heart disease, valvular heart disease, conduction disturbances, Brugada syndrome, myocardial infarction, and amyloidosis.","pmid":"16176547","section":"description"},{"id":"finding:16188595:1","type":"Finding","label":"Makita et al. (2005) described an 11-year-old boy with an apparently sporadic case of congenital atrial standstill. His surface ECG showed no P waves, and pacing could not capture his right atrium. His father, who carried the same SCN5A mutation, was in normal sinus rhythm.","pmid":"16188595","section":"clinical_features"},{"id":"hpo:HP:0033122","type":"Phenotype","label":"Absent P wave","hpo_id":"HP:0033122"},{"id":"finding:16188595:2","type":"Finding","label":"In a boy with congenital atrial standstill, Makita et al. (2005) identified a novel SCN5A mutation, L212P, which he had inherited from his father, who was in normal sinus rhythm. In a heterologous expression system studied by whole-cell patch clamp, the L212P sodium channel showed large hyperpolarizing shifts in the voltage dependence of both activation (-63.5 vs -48.1 mV) and inactivation (-95.6 vs -86.6 mV), as well as delayed recovery from inactivation.","pmid":"16188595","section":"molecular_genetics"},{"id":"variant:SCN5A:p.L212P","type":"Variant","label":"SCN5A p.L212P","gene":"SCN5A","keys":["p.L212P"],"omim_name":"SCN5A, LEU212PRO"},{"id":"finding:16188595:3","type":"Finding","label":"Makita et al. (2005) found that the proband with atrial standstill, but not his unaffected father who also carried the SCN5A L212P mutation, carried connexin-40 (Cx40) polymorphisms inherited from his asymptomatic mother. The authors suggested that coinheritance of Cx40 polymorphisms is a possible genetic factor that modifies the clinical manifestation of atrial standstill, which is consistent with digenic inheritance and incomplete penetrance.","pmid":"16188595","section":"inheritance"},{"id":"variant:GJA5:raw:cx40 polymorphisms","type":"Variant","label":"GJA5 Cx40 polymorphisms","gene":"GJA5","keys":["raw:cx40 polymorphisms"],"omim_name":"GJA5"}],"edges":[{"src":"paper:4981961","rel":"reports","dst":"finding:4981961:1"},{"src":"finding:4981961:1","rel":"in_section","dst":"section:clinical_features"},{"src":"finding:4981961:1","rel":"has_phenotype","dst":"hpo:HP:0025478","pmid":"4981961","present":true,"text":"persistent atrial standstill"},{"src":"finding:4981961:1","rel":"has_phenotype","dst":"hpo:HP:0001638","pmid":"4981961","present":true,"text":"myocardial disease"},{"src":"paper:5347950","rel":"reports","dst":"finding:5347950:1"},{"src":"finding:5347950:1","rel":"in_section","dst":"section:clinical_features"},{"src":"finding:5347950:1","rel":"has_phenotype","dst":"hpo:HP:0025478","pmid":"5347950","present":true,"text":"atrial standstill"},{"src":"paper:4636548","rel":"reports","dst":"finding:4636548:1"},{"src":"finding:4636548:1","rel":"in_section","dst":"section:clinical_features"},{"src":"finding:4636548:1","rel":"has_phenotype","dst":"hpo:HP:0001638","pmid":"4636548","present":true,"text":"atrial cardiomyopathy"},{"src":"finding:4636548:1","rel":"has_phenotype","dst":"hpo:HP:0012722","pmid":"4636548","present":true,"text":"heart block"},{"src":"paper:4430108","rel":"reports","dst":"finding:4430108:1"},{"src":"finding:4430108:1","rel":"in_section","dst":"section:clinical_features"},{"src":"finding:4430108:1","rel":"has_phe