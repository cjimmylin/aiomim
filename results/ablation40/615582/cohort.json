oles":["causal","not_causal"],"segregation":"de novo; absent in parents and two unaffected sibs","inheritance":"AD","previously_reported":"","mixed_genotypes":false,"quotes":["The proband is a 9-year-old European-American female born to nonconsanguineous, healthy parents with two older healthy children and no previous miscarriages.","A second de novo mutation was found in TGFB3 (c.1226G>A; pC409Y). Validation by Sanger sequencing confirmed that this mutation was de novo in the proband.","Her motor examination revealed decreased bulk in all appendicular and axial muscles, strength 1/5, low tone, and diminished reflexes throughout. Markedly reduced subcutaneous fat was noted."],"quote_grounding":[1.0,1.0,1.0],"followup_of":"","genotype_mode":"AD","genotype_reason":"heterozygous de novo variant"},{"id":"R:24798638:1","pmid":"24798638","label":"Patient with overgrowth and LDS features","kind":"individual","family":"","n_affected":1,"n_families":1,"sex":"","ancestry":"","consanguinity":"not_stated","onset":"","age_last":"","phenotypes":[{"text":"overgrowth","hpo_label":"Overgrowth","hpo_id":"HP:0001548","present":true,"n_with":null,"n_assessed":null,"some_only":false,"other_cause":false}],"variants":[{"gene":"TGFB3","as_reported":"De novo mutation of the latency-associated peptide domain of TGFB3","cdna":"","protein":"","genomic":"","zygosity":"unknown","origin":"de_novo","consequence":"","key":"V3"}],"variant_roles":["causal"],"segregation":"de novo","inheritance":"UNKNOWN","previously_reported":"","mixed_genotypes":false,"quotes":["De novo mutation of the latency-associated peptide domain of TGFB3 in a patient with overgrowth and Loeys-Dietz syndrome features."],"quote_grounding":[1.0],"followup_of":"","genotype_mode":"","genotype_reason":"no genotype or stated mode"},{"id":"R:25835445:1","pmid":"25835445","label":"Family 1","kind":"family","family":"Family 1","n_affected":null,"n_families":1,"sex":"","ancestry":"Dutch","consanguinity":"not_stated","onset":"","age_last