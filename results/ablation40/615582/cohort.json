ad mitral valve abnormalities, ranging from mild prolapse to severe regurgitation requiring surgical intervention. Craniofacial abnormalities were rather subtle, including a long face, high-arched palate, and retrognathia (Figure 2)."],"quote_grounding":[1.0,1.0,1.0],"followup_of":"","genotype_mode":"AD","genotype_reason":"single heterozygous variant; mode as stated for the family"},{"id":"R:25835445:2","pmid":"25835445","label":"Families 2-11","kind":"group","family":"","n_affected":null,"n_families":10,"sex":"","ancestry":"","consanguinity":"not_stated","onset":"","age_last":"","phenotypes":[{"text":"type A aortic dissection","hpo_label":"Aortic dissection","hpo_id":"HP:0002647","present":true,"n_with":null,"n_assessed":null,"some_only":true,"other_cause":false},{"text":"type B aortic dissection","hpo_label":"Aortic dissection","hpo_id":"HP:0002647","present":true,"n_with":null,"n_assessed":null,"some_only":true,"other_cause":false},{"text":"death from cerebral aneurysm dissection","hpo_label":"Arterial dissection","hpo_id":"HP:0005294","present":true,"n_with":1,"n_assessed":null,"some_only":false,"other_cause":false},{"text":"mitral valve disease","hpo_label":"Mitral regurgitation","hpo_id":"HP:0001653","present":true,"n_with":null,"n_assessed":null,"some_only":true,"other_cause":false},{"text":"patent foramen ovale","hpo_label":"Patent foramen ovale","hpo_id":"HP:0001655","present":true,"n_with":null,"n_assessed":null,"some_only":true,"other_cause":false},{"text":"atrial or ventricular septal defects","hpo_label":"Abnormal cardiac septum morphology","hpo_id":"HP:0001671","present":true,"n_with":null,"n_assessed":null,"some_only":true,"other_cause":false},{"text":"hypertelorism","hpo_label":"Hypertelorism","hpo_id":"HP:0000316","present":true,"n_with":null,"n_assessed":null,"some_only":true,"other_cause":false},{"text":"bifid uvula","hpo_label":"Bifid uvula","hpo_id":"HP:0000193","present":true,"n_with":null,"n_assessed":null,"some_only":true,"other_cause":false}