{"seed":{"mim":"500001","entry_type":"phenotype","prefix":"#","title":"LEBER OPTIC ATROPHY AND DYSTONIA","alt_titles":["LEBER HEREDITARY OPTIC NEUROPATHY WITH DYSTONIA","DYSTONIA, FAMILIAL, WITH VISUAL FAILURE AND STRIATAL LUCENCIES","MARSDEN SYNDROME"],"symbol":"LDYT","gene_symbols":["MT-ND1","MT-ND3","MT-ND4","MT-ND6"],"seed_pmids":[],"max_year":2009},"nodes":[{"id":"entry","type":"Entry","label":"LEBER OPTIC ATROPHY AND DYSTONIA","mim":"500001","entry_type":"phenotype"},{"id":"section:description","type":"Section","label":"description"},{"id":"section:nomenclature","type":"Section","label":"nomenclature"},{"id":"section:cloning_expression","type":"Section","label":"cloning_expression"},{"id":"section:gene_structure","type":"Section","label":"gene_structure"},{"id":"section:clinical_features","type":"Section","label":"clinical_features"},{"id":"section:other_features","type":"Section","label":"other_features"},{"id":"section:biochemical_features","type":"Section","label":"biochemical_features"},{"id":"section:inheritance","type":"Section","label":"inheritance"},{"id":"section:cytogenetics","type":"Section","label":"cytogenetics"},{"id":"section:mapping","type":"Section","label":"mapping"},{"id":"section:heterogeneity","type":"Section","label":"heterogeneity"},{"id":"section:gene_function","type":"Section","label":"gene_function"},{"id":"section:molecular_genetics","type":"Section","label":"molecular_genetics"},{"id":"section:genotype_phenotype_correlations","type":"Section","label":"genotype_phenotype_correlations"},{"id":"section:pathogenesis","type":"Section","label":"pathogenesis"},{"id":"section:diagnosis","type":"Section","label":"diagnosis"},{"id":"section:clinical_management","type":"Section","label":"clinical_management"},{"id":"section:population_genetics","type":"Section","label":"population_genetics"},{"id":"section:evolution","type":"Section","label":"evolution"},{"id":"section:animal_model","type":"Section","label":"animal_model"},{"id":"section:history","type":"Section","label":"history"},{"id":"paper:14735585","type":"Paper","label":"Gropman et al. (2004)","pmid":"14735585","year":2004,"content_level":"abstract","relevance":"primary","title":"Variable clinical manifestation of homoplasmic G14459A mitochondrial DNA mutation."},{"id":"paper:8622678","type":"Paper","label":"Jun et al. (1996)","pmid":"8622678","year":1996,"content_level":"abstract","relevance":"primary","title":"Use of transmitochondrial cybrids to assign a complex I defect to the mitochondrial DNA-encoded NADH dehydrogenase subunit 6 gene mutation at nucleotide pair 14459 that causes Leber hereditary optic neuropathy and dystonia."},{"id":"paper:3736869","type":"Paper","label":"Novotny et al. (1986)","pmid":"3736869","year":1986,"content_level":"abstract","relevance":"primary","title":"Leber's disease and dystonia: a mitochondrial disease."},{"id":"paper:8016139","type":"Paper","label":"Jun et al. (1994)","pmid":"8016139","year":1994,"content_level":"abstract","relevance":"primary","title":"A mitochondrial DNA mutation at nucleotide pair 14459 of the NADH dehydrogenase subunit 6 gene associated with maternally inherited Leber hereditary optic neuropathy and dystonia."},{"id":"paper:16380132","type":"Paper","label":"Watanabe et al. (2006)","pmid":"16380132","year":2006,"content_level":"abstract","relevance":"primary","title":"Leber's hereditary optic neuropathy with dystonia in a Japanese family."},{"id":"paper:8644732","type":"Paper","label":"De Vries et al. (1996)","pmid":"8644732","year":1996,"content_level":"abstract","relevance":"primary","title":"Genetic and biochemical impairment of mitochondrial complex I activity in a family with Leber hereditary optic neuropathy and hereditary spastic dystonia."},{"id":"paper:19458970","type":"Paper","label":"Wang et al. (2009)","pmid":"19458970","year":2009,"content_level":"abstract","relevance":"primary","title":"Mitochondrial ND3 as the novel causative gene for Leber hereditary optic neuropathy and dystonia."},{"id":"paper:17562939","type":"Paper","label":"Spruijt et al. (2007)","pmid":"17562939","year":2007,"content_level":"abstract","relevance":"primary","title":"A MELAS-associated ND1 mutation causing leber hereditary optic neuropathy and spastic dystonia."},{"id":"paper:14735584","type":"Paper","label":"Tarnopolsky et al. (2004)","pmid":"14735584","year":2004,"content_level":"abstract","relevance":"supporting","title":"Clinical variability in maternally inherited leber hereditary optic neuropathy with the G14459A mutation."},{"id":"paper:3711913","type":"Paper","label":"Marsden et al. (1986)","pmid":"3711913","year":1986,"content_level":"abstract","relevance":"primary","title":"Familial dystonia and visual failure with striatal CT lucencies."},{"id":"paper:5418396","type":"Paper","label":"Wallace (1970)","pmid":"5418396","year":1970,"content_level":"title","relevance":"supporting","title":"A new manifestation of Leber's disease and a new explanation for the agency responsible for its unusual pattern of inheritance."},{"id":"paper:7654063","type":"Paper","label":"Shoffner et al. (1995)","pmid":"7654063","year":1995,"content_level":"abstract","relevance":"primary","title":"Leber's hereditary optic neuropathy plus dystonia is caused by a mitochondrial DNA point mutation."},{"id":"finding:5418396:1","type":"Finding","label":"Wallace (1970) described a new manifestation of Leber disease (Leber hereditary optic neuropathy) and proposed a new explanation for the agent responsible for its unusual pattern of inheritance.","pmid":"5418396","section":"clinical_features"},{"id":"finding:3711913:1","type":"Finding","label":"Marsden et al. (1986) described a disorder in 7 members of 2 families in whom dystonia was variably associated with subacute visual loss or asymptomatic optic atrophy, and with striking bilateral symmetrical lucencies on CT scan, especially involving the putamen.","pmid":"3711913","section":"clinical_features"},{"id":"hpo:HP:0001332","type":"Phenotype","label":"Dystonia","hpo_id":"HP:0001332"},{"id":"hpo:HP:0000572","type":"Phenotype","label":"Visual loss","hpo_id":"HP:0000572"},{"id":"hpo:HP:0000648","type":"Phenotype","label":"Optic atrophy","hpo_id":"HP:0000648"},{"id":"hpo:HP:0031982","type":"Phenotype","label":"Abnormal putamen morphology","hpo_id":"HP:0031982"},{"id":"finding:3711913:2","type":"Finding","label":"Marsden et al. (1986) suggested that the condition might be a variant of Leigh disease but noted considerable differences from pathologically proven Leigh disease, and stated that it must be excluded in all patients thought to have idiopathic dystonia, subacute visual failure similar to Leber optic neuropathy, or a combination of these disorders.","pmid":"3711913","section":"diagnosis"},{"id":"finding:3736869:1","type":"Finding","label":"Novotny et al. (1986) studied a kindred in which 8 members had the neuroretinopathy of Leber disease, 14 had a progressive, generalized dystonia attributed to striatal degeneration, and 1 had both disorders.","pmid":"3736869","section":"clinical_features"},{"id":"hpo:HP:0007325","type":"Phenotype","label":"Generalized dystonia","hpo_id":"HP:0007325"},{"id":"hpo:HP:0010994","type":"Phenotype","label":"Abnormal corpus striatum morphology","hpo_id":"HP:0010994"},{"id":"finding:3736869:2","type":"Finding","label":"Novotny et al. (1986) found that the mode of inheritance in the kindred with Leber disease and dystonia was compatible with maternal transmission, and suggested that the disorder may be a mitochondrial disease.","pmid":"3736869","section":"inheritance"},{"id":"inh:MT","type":"Inheritance","label":"Mitochondrial","hpo_id":"HP:0001427"},{"id":"finding:8016139:1","type":"Finding","label":"Jun et al. (1994) studied a 5-generation Hispanic family in which members had maternally transmitted Leber hereditary optic neuropathy, early-onset dystonia associated with bilateral basal ganglia lesions, or both.","pmid":"8016139","section":"clinical_features"},{"id":"hpo:HP:0001138","type":"Phenotype","label":"Optic neuropathy","hpo_id":"HP:0001138"},{"id":"hpo:HP:0002134","type":"Phenotype","label":"Abnormal basal ganglia morphology","hpo_id":"HP:0002134"},{"id":"finding:8016139:2","type":"Finding","label":"In a 5-generation Hispanic family with LHON and/or dystonia, Jun et al. (1994) sequenced more than 90% of the mtDNA from a severely affected child and identified a G-to-A transition at nucleotide 14459 of the ND6 gene, resulting in an ala72-to-val substitution at a moderately conserved residue. The child's mtDNA belonged to Native American haplogroup D. The variant was not found in 38 Native American haplogroup D mtDNAs or in 108 Asian, 103 Caucasian, or 99 African mtDNAs. Six maternal relatives in 3 generations carried the mutation; one female with LHON was heteroplasmic. The authors suggested that it was the disease-causing mutation.","pmid":"8016139","section":"molecular_genetics"},{"id":"gene:MT-ND6","type":"Gene","label":"MT-ND6"},{"id":"variant:MT-ND6:m.14459G>A","type":"Variant","label":"MT-ND6 m.14459G>A / p.A72V","gene":"MT-ND6","keys":["m.14459G>A","p.A72V"],"omim_name":"MTND6, ALA72VAL"},{"id":"finding:7654063:1","type":"Finding","label":"Shoffner et al. (1995) described two more pedigrees carrying the MTND6*LDYT14459A mutation. In one pedigree, two family members developed Leber hereditary optic neuropathy, and the daughter had basal ganglia lesions that caused no symptoms. In the second pedigree, one person had generalized dystonia beginning in childhood, along with bilateral basal ganglia lesions.","pmid":"7654063","section":"clinical_features"},{"id":"finding:7654063:2","type":"Finding","label":"Shoffner et al. (1995) found the MTND6*LDYT14459A point mutation in the ND6 subunit of complex I, at mtDNA position 14459, in two pedigrees beyond the original family. The authors concluded that this confirmed the mutation's association with Leber hereditary optic neuropathy and/or dystonia. They called it the first genetic abnormality identified as a cause of generalized dystonia.","pmid":"7654063","section":"molecular_genetics"},{"id":"finding:7654063:3","type":"Finding","label":"Shoffner et al. (1995) did not find the MTND6*LDYT14459A mutation in patient groups with Leigh disease, dystonia plus complex neurodegeneration, or Leber hereditary optic neuropathy. They suggested that the mutation is highly tissue-specific and therefore produces a narrow range of phenotypes.","pmid":"7654063","section":"genotype_phenotype_correlations"},{"id":"variant:MT-ND6:raw:mtnd6*ldyt14459a","type":"Variant","label":"MT-ND6 MTND6*LDYT14459A","gene":"MT-ND6","keys":["raw:mtnd6*ldyt14459a"],"omim_name":"MTND6"},{"id":"finding:8622678:1","type":"Finding","label":"Jun et al. (1996) noted that a heteroplasmic G-to-A transition at nucleotide 14459 of the mtDNA-encoded ND6 gene, which changes a moderately conserved alanine to valine at position 72 (A72V), had been identified as the cause of Leber hereditary optic neuropathy and/or pediatric-onset dystonia in 3 unrelated families.","pmid":"8622678","section":"molecular_genetics"},{"id":"finding:8622678:2","type":"Finding","label":"Jun et al. (1996) found a 60% reduction (P < 0.005) of complex I-specific activity in submitochondrial particles from EBV-transformed lymphoblasts of patients with the ND6 14459 mutation compared with controls, with no differences in activity of complexes II plus III, III, and IV.","pmid":"8622678","section":"biochemical_features"},{"id":"hpo:HP:0011923","type":"Phenotype","label":"Decreased activity of mitochondrial complex I","hpo_id":"HP:0011923"},{"id":"finding:8622678:3","type":"Finding","label":"Using transmitochondrial cybrids made by fusing enucleated patient lymphoblasts to a mtDNA-deficient (rho-0) lymphoblastoid line, Jun et al. (1996) assigned the complex I defect to the 14459 mutation: mutant cybrids showed a 39% reduction (p < 0.02) in complex I-specific activity relative to wildtype cybrids, with normal activity of other complexes. Kinetic analysis showed reduced Vmax with unchanged Km, and activity was inhibited by increasing concentrations of decylubiquinol, suggesting the mutation may alter the coenzyme Q-binding site of complex I.","pmid":"8622678","section":"molecular_genetics"},{"id":"finding:8644732:1","type":"Finding","label":"De Vries et al. (1996) studied a large Dutch family with a rare form of Leber hereditary optic neuropathy (LHON) associated with hereditary spastic dystonia. Some family members had both the neurologic and ophthalmologic lesions, while others had only one type of abnormality.","pmid":"8644732","section":"clinical_features"},{"id":"finding:8644732:2","type":"Finding","label":"In a large Dutch family with LHON and hereditary spastic dystonia, De Vries et al. (1996) found no previously reported LHON mtDNA mutations. Sequencing of the protein-coding mitochondrial genes found a heteroplasmic 11696A-G transition in the ND4 gene, causing a val312-to-ile substitution.","pmid":"8644732","section":"molecular_genetics"},{"id":"gene:MT-ND4","type":"Gene","label":"MT-ND4"},{"id":"variant:MT-ND4:m.11696A>G","type":"Variant","label":"MT-ND4 m.11696A>G / p.V312I","gene":"MT-ND4","keys":["m.11696A>G","p.V312I"],"omim_name":"MTND4, VAL312ILE"},{"id":"finding:8644732:3","type":"Finding","label":"In the same Dutch family, De Vries et al. (1996) also found a homoplasmic 14596T-A transition in the ND6 gene, causing an ile26-to-met substitution. Neither mutation had been reported before.","pmid":"8644732","section":"molecular_genetics"},{"id":"variant:MT-ND6:m.14596T>A","type":"Variant","label":"MT-ND6 m.14596T>A / p.I26M","gene":"MT-ND6","keys":["m.14596T>A","p.I26M"],"omim_name":"MTND6, ILE26MET"},{"id":"finding:8644732:4","type":"Finding","label":"De Vries et al. (1996) found a severe complex I deficiency in a muscle biopsy from the family. They said this linked the new mtDNA mutations to the rare, complex phenotype that includes Leber optic neuropathy.","pmid":"8644732","section":"biochemical_features"},{"id":"finding:14735584:1","type":"Finding","label":"Tarnopolsky et al. (2004) described 2 Caucasian pedigrees with maternally inherited Leber hereditary optic neuropathy (LHON) phenotypes that varied greatly from patient to patient. In one patient with spasticity/dystonia, the only abnormal screening test was a high T2 signal in both putamina. A male patient in the second pedigree had optic neuropathy without spasticity or dystonia.","pmid":"14735584","section":"clinical_features"},{"id":"hpo:HP:0001257","type":"Phenotype","label":"Spasticity","hpo_id":"HP:0001257"},{"id":"finding:14735584:2","type":"Finding","label":"Tarnopolsky et al. (2004) found the mitochondrial DNA G14459A transition (14,459 G-to-A) in 2 Caucasian pedigrees with maternally inherited LHON, with or without spasticity/dystonia. They concluded that the findings further supported a causal role for this mutation in both LHON and spasticity/dystonia.","pmid":"14735584","section":"molecular_genetics"},{"id":"finding:14735584:3","type":"Finding","label":"Tarnopolsky et al. (2004) observed that the G14459A mutation produced very different phenotypes. In one pedigree, a patient had spasticity/dystonia with putaminal lesions. In the other pedigree, a male had optic neuropathy without spasticity or dystonia.","pmid":"14735584","section":"genotype_phenotype_correlations"},{"id":"finding:14735585:1","type":"Finding","label":"Gropman et al. (2004) reported a family with the G14459A mtDNA mutation and a broad range of clinical features. The proband was a 3-year-old girl with anarthria, dystonia, spasticity and mild encephalopathy. Brain MRI showed bilateral, symmetric basal ganglia lucencies, and she had cerebral and systemic lactic acidosis. Her maternal first cousin had a much milder phenotype: a new-onset limp and mild hemiparesis, with similar MRI findings.","pmid":"14735585","section":"clinical_features"},{"id":"hpo:HP:0002425","type":"Phenotype","label":"Anarthria","hpo_id":"HP:0002425"},{"id":"hpo:HP:0001298","type":"Phenotype","label":"Encephalopathy","hpo_id":"HP:0001298"},{"id":"hpo:HP:0003128","type":"Phenotype","label":"Lactic acidosis","hpo_id":"HP:0003128"},{"id":"hpo:HP:0001288","type":"Phenotype","label":"Gait disturbance","hpo_id":"HP:0001288"},{"id":"hpo:HP:0001269","type":"Phenotype","label":"Hemiparesis","hpo_id":"HP:0001269"},{"id":"finding:14735585:2","type":"Finding","label":"In a family with a broad range of clinical features, including a proband with pediatric-onset dystonia, Gropman et al. (2004) identified the homoplasmic G14459A mutation in the mtDNA ND6 gene (MT-ND6). The mutation changes a moderately conserved alanine to valine at residue 72 (ala72-to-val), within the most evolutionarily conserved region of ND6. Family members carrying the mutation included both asymptomatic and symptomatic individuals, who had variable clinical and laboratory features of mitochondrial disease.","pmid":"14735585","section":"molecular_genetics"},{"id":"finding:14735585:3","type":"Finding","label":"Gropman et al. (2004) noted that clinical expression of the homoplasmic G14459A mutation varies even within a single family. They suggested that this supports the hypothesis that nuclear genes may modify the clinical expression of mitochondrial disease.","pmid":"14735585","section":"heterogeneity"},{"id":"finding:16380132:1","type":"Finding","label":"Watanabe et al. (2006) described a Japanese family in which affected members had generalized dystonia, attributed to striatal degeneration, beginning in childhood, and optic neuropathy beginning later in life.","pmid":"16380132","section":"clinical_features"},{"id":"finding:16380132:2","type":"Finding","label":"Watanabe et al. (2006) sequenced the entire mtDNA of the proband from a Japanese family with LHON and dystonia and found 42 nucleotide changes compared with the revised Cambridge Reference Sequence. These included the G14459A mutation in the ND6 gene (MT-ND6), which was absent from 200 healthy Japanese controls. The authors noted that this mutation had previously been suggested as the cause of LHON and/or dystonia in Hispanic, African American, and Caucasian families, and they reported this as the first Japanese family with LHON and dystonia in which an mtDNA mutation was found.","pmid":"16380132","section":"molecular_genetics"},{"id":"finding:16380132:3","type":"Finding","label":"Watanabe et al. (2006) also found an A3203G change in the proband's mtDNA. This change was absent from 200 healthy Japanese controls, and the authors stated that its significance remained unknown.","pmid":"16380132","section":"molecular_genetics"},{"id":"variant::c.3203A>G","type":"Variant","label":" c.3203A>G / m.3203A>G","keys":["c.3203A>G","m.3203A>G"],"omim_name":", 3203A-G"},{"id":"finding:17562939:1","type":"Finding","label":"In a patient with LHON who did not carry one of the 3 primary LHON mutations, Spruijt et al. (2007) screened the complete mitochondrial DNA and found a pathogenic 3697G>A mutation in the MT-ND1 gene. The mutation appeared to be associated with isolated complex I deficiency. The authors determined the heteroplasmy level, but the abstract does not give it. They concluded that the mutation caused both LHON and spastic dystonia in the same family.","pmid":"17562939","section":"molecular_genetics"},{"id":"gene:MT-ND1","type":"Gene","label":"MT-ND1"},{"id":"variant:MT-ND1:m.3697G>A","type":"Variant","label":"MT-ND1 m.3697G>A","gene":"MT-ND1","keys":["m.3697G>A"],"omim_name":"MTND1, 3697G-A"},{"id":"finding:17562939:2","type":"Finding","label":"Spruijt et al. (2007) described a family in which LHON and spastic dystonia occurred together. They said the family's clinical features were similar to those of previously described families with LHON and dystonia caused by an ND6 mutation.","pmid":"17562939","section":"clinical_features"},{"id":"finding:17562939:3","type":"Finding","label":"Spruijt et al. (2007) noted that the 3697G>A MT-ND1 mutation can also cause MELAS syndrome. They suggested that other genetic factors may contribute to how the disease is expressed clinically.","pmid":"17562939","section":"genotype_phenotype_correlations"},{"id":"finding:19458970:1","type":"Finding","label":"Wang et al. (2009) described a Chinese family with 18 patients affected by Leber hereditary optic neuropathy and dystonia (LDYT), a disorder in which vision loss and progressive generalized dystonia occur in variable combinations.","pmid":"19458970","section":"clinical_features"},{"id":"gene:MT-ND3","type":"Gene","label":"MT-ND3"},{"id":"finding:19458970:2","type":"Finding","label":"In a Chinese family with LDYT, Wang et al. (2009) used resequencing microarray analysis of the entire mitochondrial genome and identified a m.10197G>A mutation in the MTND3 gene, which substituted threonine for a highly conserved alanine at codon 47 (Ala47Thr), on a haplogroup D4b background. Quantitative heteroplasmy analysis showed that the mutation was homoplasmic in leukocytes of all affected individuals on the maternal side. The authors stated that this was the first ND3 mutation reported to cause LDYT.","pmid":"19458970","section":"molecular_genetics"},{"id":"variant:MT-ND3:m.10197G>A","type":"Variant","label":"MT-ND3 m.10197G>A / p.A47T","gene":"MT-ND3","keys":["m.10197G>A","p.A47T"],"omim_name":"MTND3, ALA47THR"},{"id":"finding:19458970:3","type":"Finding","label":"Wang et al. (2009) noted that the m.10197G>A mutation in MTND3 had also been reported in French and Korean patients with Leigh syndrome. They suggested that the clinical spectrum of this mutation is much wider and includes both LDYT and Leigh syndrome.","pmid":"19458970","section":"genotype_phenotype_correlations"},{"id":"finding:19458970:4","type":"Finding","label":"Wang et al. (2009) noted that LDYT, an oxidative phosphorylation disorder, had previously been attributed to mutations in the mitochondrial ND6 or ND4 genes. Their finding of an ND3 mutation in LDYT therefore added a further causative gene.","pmid":"19458970","section":"heterogeneity"}],"edges":[{"src":"paper:5418396","rel":"reports","dst":"finding:5418396:1"},{"src":"finding:5418396:1","rel":"in_section","dst":"section:clinical_features"},{"src":"paper:3711913","rel":"reports","dst":"finding:3711913:1"},{"src":"finding:3711913:1","rel":"in_section","dst":"section:clinical_features"},{"src":"finding:3711913:1","rel":"has_phenotype","dst":"hpo:HP:0001332","pmid":"3711913","present":true,"text":"dystonia"},{"src":"finding:3711913:1","rel":"has_phenotype","dst":"hpo:HP:0000572","pmid":"3711913","present":true,"text":"subacute visual loss"},{"src":"finding:3711913:1","rel":"has_phenotype","dst":"hpo:HP:0000648","pmid":"3711913","present":true,"text":"asymptomatic optic atrophy"},{"src":"finding:3711913:1","rel":"has_phenotype","dst":"hpo:HP:0031982","pmid":"3711913","present":true,"text":"bilateral symmetrical putaminal lucencies on CT"},{"src":"paper:3711913","rel":"reports","dst":"finding:3711913:2"},{"src":"finding:3711913:2","rel":"in_section","dst":"section:diagnosis"},{"src":"paper:3736869","rel":"reports","dst":"finding:3736869:1"},{"src":"finding:3736869:1","rel":"in_section","dst":"section:clinical_features"},{"src":"finding:3736869:1","rel":"has_phenotype","dst":"hpo:HP:0000648","pmid":"3736869","present":true,"text":"Leber neuroretinopathy"},{"src":"finding:3736869:1","rel":"has_phenotype","dst":"hpo:HP:0007325","pmid":"3736869","present":true,"text":"progressive generalized dystonia"},{"src":"finding:3736869:1","rel":"has_phenotype","dst":"hpo:HP:0010994","pmid":"3736869","present":true,"text":"striatal degeneration"},{"src":"paper:3736869","rel":"reports","dst":"finding:3736869:2"},{"src":"finding:3736869:2","rel":"in_section","dst":"section:inheritance"},{"src":"finding:3736869:2","rel":"asserts_inheritance","dst":"inh:MT","pmid":"3736869"},{"src":"paper:8016139","rel":"reports","dst":"finding:8016139:1"},{"src":"finding:8016139:1","rel":"in_section","dst":"se